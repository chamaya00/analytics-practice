---
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
  </head>
  <body>
    <Header currentPath={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <a href="/about/">What we log, and why</a>
    </footer>
  </body>
</html>

<script>
  import { initTracking } from '../lib/tracking-transport';

  initTracking();
</script>

<style is:global>
  /* Sitewide per docs/design/65-parody-flow.md's "Privacy note" section —
     same link text and destination as the checkout page's contextual one,
     so it reads as the same document found twice. Sits under the
     tab-bar-clearing padding main.astro already reserves at phone width. */
  .site-footer {
    max-width: 40rem;
    margin: 0 auto;
    padding: 0 var(--space-lg) var(--space-xl);
    text-align: center;
  }

  .site-footer a {
    color: var(--color-text-muted);
    font-size: var(--font-size-muted);
    letter-spacing: 0.05em;
  }

  /* main's own bottom padding (global.css) only clears the fixed tab bar for
     main's own content — the footer sits after it, so it needs the same
     clearance or the tab bar covers it at the bottom of the page. */
  @media (max-width: 480px) {
    .site-footer {
      padding-bottom: calc(56px + env(safe-area-inset-bottom) + var(--space-xl));
    }
  }

  /* Shared component styles for the Dontdropthatpromo parody
     (docs/design/65-parody-flow.md, docs/design/72-dontdropthatpromo-identity.md),
     used by more than one page's DOM module — lives here rather than
     duplicated per page, same reasoning as .reset-button in global.css. All
     tokens (spacing, color, type) are global.css's own, unchanged. */

  /* ---- landing: order-in-progress banner ---- */

  .order-banner {
    display: block;
    margin-bottom: var(--space-lg);
    padding: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-accent-a);
    color: var(--color-accent-a);
    font-weight: 700;
    text-decoration: none;
  }

  /* ---- home feed: location bar, search, promo banner, cuisine chips ----
     docs/design/80-two-city-brand-and-flow.md, screen 2 / 80-home-sf.html.
     Rendered by home-dom.ts into #home-root, which BaseLayout gives no
     scoped <style> of its own — these live here, unscoped, the same as
     every other DOM-module component below. */

  .location-bar {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: inherit;
    font-size: var(--font-size-muted);
    font-weight: 700;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: var(--space-xs) var(--space-md);
    min-height: 32px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* The mock's phone-width header puts the city chip directly under the
     wordmark, gap var(--space-xs) (docs/design/80-home-sf.html's own
     .site-header/.brand-group), because there the chip lives inside the
     header itself. Header.astro renders only the wordmark — the chip is
     home-dom.ts's own first element, sitting in main below it — so closing
     the same gap here means trimming main's own top padding for this one
     screen rather than moving the chip's markup into the shared header,
     which every other page also renders (driver review, #104 round 1,
     item 2). */
  @media (max-width: 480px) {
    main:has(.home-feed) {
      padding-top: var(--space-xs);
    }
  }

  .home-search {
    display: block;
    width: 100%;
    min-height: 44px;
    margin-top: var(--space-md);
    padding: 0 var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-body);
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .home-search::placeholder {
    color: var(--color-text-muted);
  }

  .promo-banner {
    margin-top: var(--space-md);
    padding: var(--space-md);
    /* Column: the mock's own two lines, claim then sub, stacked rather than
       side by side (docs/design/80-home-sf.html's .promo-banner) — no image
       in this slot (driver review, #104 round 1, item 1: it had no Unsplash
       search named for it in #80 and was left showing a permanent
       "Placeholder"). */
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-accent-a);
    border-radius: 12px;
  }

  .promo-banner-claim {
    font-weight: 800;
    font-size: var(--font-size-body);
    color: var(--color-accent-a);
  }

  .promo-banner-sub {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .cuisine-chips {
    margin-top: var(--space-md);
    display: flex;
    gap: var(--space-sm);
    overflow-x: auto;
    -webkit-mask-image: linear-gradient(to right, black 88%, transparent);
    mask-image: linear-gradient(to right, black 88%, transparent);
    padding-right: var(--space-lg);
  }

  .cuisine-chip {
    flex: none;
    min-height: 36px;
    display: flex;
    align-items: center;
    padding: 0 var(--space-md);
    font-family: inherit;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    font-size: var(--font-size-muted);
    font-weight: 700;
    color: var(--color-text-muted);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .cuisine-chip.selected {
    color: var(--color-accent-a);
    border-color: var(--color-accent-a);
  }

  /* Home feed's "Near you" heading (#80/#104: docs/design/80-home-sf.html's
     h2.section-title) — its own class rather than the Offers screen's
     .section-title (defined further below), which is deliberately smaller
     and muted rather than this compact-page-title scale. */
  .home-section-title {
    font-size: var(--font-size-h2);
    font-weight: 700;
    margin: var(--space-lg) 0 var(--space-sm);
  }

  /* ---- location picker (home screen 1) ---- */

  .location-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .location-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    padding: var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-body);
    color: var(--color-text);
    text-align: left;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .location-card img {
    border-radius: 8px;
    object-fit: cover;
  }

  .location-card-name {
    font-weight: 800;
  }

  .location-card-currency {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .location-blocked-notice {
    margin-top: var(--space-md);
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  /* ---- restaurant list ---- */

  .restaurant-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin: var(--space-md) 0 0;
    padding: 0;
  }

  .restaurant-card {
    position: relative;
    display: flex;
    gap: var(--space-md);
    padding: var(--space-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    color: var(--color-text);
    text-decoration: none;
    transition: transform 100ms ease-out;
    /* docs/design/46-phone-native.md, Touch feedback: no default browser
       tap-highlight, no text selection or iOS link-preview callout on a
       long press — every touch target on this site follows it, not only
       the ones #46 itself introduced. */
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
  }

  .restaurant-card:active {
    transform: scale(0.98);
  }

  .restaurant-card-photo {
    flex: none;
    width: 72px;
    height: 72px;
    border-radius: 10px;
    object-fit: cover;
  }

  .restaurant-card-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-width: 0;
  }

  .restaurant-card-name {
    font-weight: 800;
  }

  .restaurant-card-tag,
  .restaurant-card-meta {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .deal-badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    background: var(--color-accent-b);
    color: var(--color-badge-ink);
    font-size: 0.625rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 999px;
  }

  /* ---- menu / cart line items, shared shape ---- */

  .menu-list,
  .cart-list {
    list-style: none;
    margin: 0 0 var(--space-lg);
    padding: 0;
  }

  .menu-item-row,
  .cart-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
  }

  /* ---- cart row: swipe left to reveal "Remove" (swipe-row.ts) ----
     Two layers in one clipped row: .swipe-action pinned to the trailing
     edge, and the line's own content (.cart-line) on top of it with an
     opaque background. A left drag moves the content; .is-open parks it
     88px left (swipe-row.ts's SWIPE_OPEN_OFFSET_PX), uncovering the action.
     touch-action: pan-y leaves vertical drags to the page's scroll, so
     only a sideways drag becomes a swipe.

     The row bleeds into main's own side padding (exactly var(--space-lg),
     global.css) and pads itself back in by the same amount, so the clip
     edge is the screen edge: sliding content leaves the screen rather than
     being cut mid-word at the text column. The divider stays on the text
     column via ::after. */
  .cart-row {
    position: relative;
    overflow: hidden;
    margin: 0 calc(-1 * var(--space-lg));
    padding: 0 var(--space-lg);
  }

  .cart-row::after {
    content: '';
    position: absolute;
    left: var(--space-lg);
    right: var(--space-lg);
    bottom: 0;
    z-index: 2;
    border-bottom: 1px solid var(--color-border);
    pointer-events: none;
  }

  .cart-row > .cart-line {
    position: relative;
    z-index: 1;
    flex-wrap: nowrap;
    border-bottom: none;
    background: var(--color-bg);
    touch-action: pan-y;
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
  }

  .cart-row.is-open > .cart-line {
    transform: translateX(-88px);
  }

  /* While a finger is down the content follows it exactly — no easing
     lagging behind the drag. */
  .cart-row.is-dragging > .cart-line {
    transition: none;
  }

  .swipe-action {
    position: absolute;
    top: var(--space-sm);
    bottom: var(--space-sm);
    right: var(--space-lg);
    width: 80px;
    padding: 0;
    font-family: inherit;
    font-size: var(--font-size-muted);
    font-weight: 800;
    color: var(--color-bg);
    background: var(--color-danger);
    border: none;
    border-radius: 12px;
    cursor: pointer;
    /* #105's icon-plus-label reading (105-cart-single-sf.html): "Remove"
       reads from its own trash icon and weight, not the red fill alone. */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
  }

  .swipe-action svg {
    width: 18px;
    height: 18px;
  }

  .swipe-action:active {
    transform: scale(0.97);
  }

  .cart-line-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    /* Without this the column's default stretch would give the stepper
       pill (an inline-flex item here, not a block) the row's full width
       instead of sizing to its own content (105-cart-single-sf.html). */
    align-items: flex-start;
    gap: 2px;
  }

  .cart-line-name {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  /* 84px/10px radius, matching the home feed's own restaurant-card thumbnail
     treatment (#105: criterion 2) — shared by the menu's dish rows and the
     cart's line-item rows below, not a separate class per screen. */
  .menu-item-photo {
    flex: none;
    width: 84px;
    height: 84px;
    border-radius: 10px;
    object-fit: cover;
  }

  /* The dish name, description and price sit in their own wrapping element
     (menu-dom.ts's textWrap) rather than being direct .menu-item-row
     children like .cart-line-name above — stacked here rather than left to
     fall onto one run-together line (driver review, #82 round 1, item 4). */
  .menu-item-text {
    flex: 1;
    min-width: 8rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .menu-item-name {
    font-weight: 700;
  }

  .menu-item-description {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .menu-item-price,
  .cart-line-total {
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  /* #105: a rounded pill container with two filled circular buttons — the
     mocks' own stepper shape (105-menu-sf.html, 105-cart-single-sf.html),
     replacing the bordered-square buttons #104 left behind on this
     component. */
  .quantity-stepper {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 36px;
    padding: 0 var(--space-sm);
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-accent-a);
  }

  .quantity-stepper button {
    width: 22px;
    height: 22px;
    font-family: inherit;
    font-weight: 800;
    line-height: 1;
    color: var(--color-bg);
    background: var(--color-accent-a);
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .quantity-count {
    min-width: 1.5rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .add-button {
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-body);
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    -webkit-tap-highlight-color: transparent;
  }

  /* #105's CartSummaryBar: fixed above the phone tab bar (105-menu-sf.html's
     .cart-summary-bar), a plain rounded bar at the foot of content on
     desktop where there is no tab bar to clear. */
  .cart-summary-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-accent-a);
    color: var(--color-bg);
    text-decoration: none;
  }

  .cart-summary-bar .summary-text {
    font-size: var(--font-size-muted);
    font-weight: 700;
  }

  .cart-summary-bar .view-cart {
    font-weight: 800;
  }

  @media (max-width: 480px) {
    .cart-summary-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: calc(56px + env(safe-area-inset-bottom));
    }
  }

  @media (min-width: 481px) {
    .cart-summary-bar {
      border-radius: 12px;
      margin-top: var(--space-lg);
    }
  }

  /* ---- "Your carts": one card per restaurant (cart-dom.ts) ----
     Every restaurant is its own cart, so with several the Cart tab lists
     them rather than merging them. Each card reuses the home feed's
     .restaurant-card shape (and its touch feedback) with a smaller photo and
     the cart's own subtotal on the trailing edge. */

  .cart-list-note {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .cart-cards {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin: 0 0 var(--space-lg);
    padding: 0;
  }

  .cart-card {
    align-items: center;
  }

  .cart-card .cart-card-photo {
    width: 56px;
    height: 56px;
  }

  .cart-card-subtotal {
    flex: none;
    margin-left: auto;
    padding-right: var(--space-xs);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  /* One restaurant's cart and the Offers screen both head the page with a
     back chevron beside the title; the title sits on the chevron's centre
     line rather than carrying its usual bottom margin inside the row. */
  .top-bar h1 {
    margin: 0;
    min-width: 0;
  }

  a.back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .back svg {
    display: block;
    width: 24px;
    height: 24px;
  }

  .checkout-restaurant {
    margin: 0 0 var(--space-sm);
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  /* 105-cart-single-sf.html's breakdown-preview: Subtotal and Delivery fee
     as .breakdown-row label/value lines (Checkout's own shape), not bold
     "Subtotal: $X" text. */
  .cart-breakdown {
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .cart-fee-note {
    margin-top: 0;
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  /* ---- remove-confirm dialog (confirm-dialog-dom.ts): the cart stepper's
     minus at quantity 1 ---- */

  .confirm-overlay {
    position: fixed;
    inset: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-lg);
  }

  .confirm-scrim {
    position: fixed;
    inset: 0;
    background: rgba(36, 27, 51, 0.45);
  }

  .confirm-dialog {
    position: relative;
    width: 100%;
    max-width: 22rem;
    padding: var(--space-lg);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    /* #105's own critique caught a one-off 16px on this sheet and corrected
       it to the system's own 12px card radius (105-cart-remove-modal.html). */
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(36, 27, 51, 0.18);
    animation: confirm-in 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes confirm-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .confirm-title {
    margin: 0 0 var(--space-xs);
    font-size: var(--font-size-h2);
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .confirm-body {
    margin: 0 0 var(--space-lg);
    color: var(--color-text-muted);
  }

  .confirm-actions {
    display: flex;
    gap: var(--space-sm);
  }

  .confirm-button {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 0 var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-body);
    font-weight: 800;
    border-radius: 999px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
  }

  .confirm-button:active {
    transform: scale(0.97);
  }

  .confirm-button:focus-visible,
  .swipe-action:focus-visible {
    outline: 2px solid var(--color-accent-a);
    outline-offset: 2px;
  }

  .confirm-cancel {
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .confirm-danger {
    color: var(--color-bg);
    background: var(--color-danger);
    border: 1px solid var(--color-danger);
  }

  /* Checkout and Offers both put their own page title directly under the
     wordmark, the same as the home feed above — their mocks (80-checkout-
     hcmc.html, 87-offers-hcmc.html) give main a --space-md top padding,
     against this site's default --space-xl, so the gap above "Checkout" /
     "Offers" at phone width reads about twice the mock's own (driver review,
     #107 round 1, item 2). */
  @media (max-width: 480px) {
    main:has(#checkout-root),
    main:has(#offers-root) {
      padding-top: var(--space-md);
    }
  }

  /* ---- checkout fields: preset choices only, nothing typed ---- */

  .checkout-field {
    margin-bottom: var(--space-sm);
  }

  .mini-field {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .mini-label {
    font-size: var(--font-size-muted);
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .chip-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .chip {
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-muted);
    font-weight: 600;
    line-height: 1.15;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .chip.selected {
    color: var(--color-accent-a);
    border-color: var(--color-accent-a);
    font-weight: 800;
  }

  /* The mock's right-aligned toggle pair sits smaller than the preset
     chip-groups above it (docs/design/80-checkout-hcmc.html's .toggle). */
  .mini-field .chip-group {
    gap: var(--space-xs);
  }

  .mini-field .chip {
    min-height: 32px;
    padding: 0 var(--space-sm);
  }

  .privacy-note {
    margin: 0 0 var(--space-lg);
  }

  .privacy-note a {
    color: var(--color-text-muted);
    font-size: var(--font-size-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* ---- checkout price breakdown (#80: Subtotal, Delivery fee, Service fee,
     Total — #89 adds Discount/"You saved" lines to this same block) ---- */

  .checkout-breakdown {
    margin: var(--space-md) 0;
    padding-top: var(--space-xs);
    border-top: 1px solid var(--color-border);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
    padding: var(--space-xs) 0;
  }

  .breakdown-row .muted {
    color: var(--color-text-muted);
  }

  .breakdown-row.total {
    font-weight: 800;
    font-size: var(--font-size-h2);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-xs);
    padding-top: var(--space-sm);
  }

  /* #87/#89: the delivery-fee row's struck-through original next to "Free"
     or the reduced flash price, the Discount row, and the "You saved"
     sub-line — docs/design/80-checkout-hcmc.html's own breakdown block. */
  .breakdown-row .struck {
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .breakdown-row .free {
    color: var(--color-accent-a);
    font-weight: 800;
  }

  .breakdown-row.discount {
    color: var(--color-accent-a);
    font-weight: 800;
  }

  .breakdown-row.discount .icon-tag {
    flex: none;
    width: 16px;
    height: 16px;
    vertical-align: -3px;
    margin-right: 4px;
    color: var(--color-accent-a);
  }

  .saved-line {
    font-size: var(--font-size-muted);
    font-weight: 800;
    color: var(--color-accent-a);
    text-align: right;
    margin: -2px 0 var(--space-xs);
  }

  /* #87/#89: checkout's Offers row, replacing the old promo chip group. */
  .offers-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    width: 100%;
    margin-top: var(--space-sm);
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    border-left: none;
    border-right: none;
    font-family: inherit;
    font-size: var(--font-size-body);
    text-align: left;
    color: var(--color-text);
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .offers-row .label {
    font-weight: 700;
  }

  .offers-row .summary {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: var(--font-size-muted);
    color: var(--color-accent-a);
    font-weight: 700;
  }

  .offers-row .chevron {
    flex: none;
    width: 14px;
    height: 14px;
  }

  .offers-drop-notice {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    margin: var(--space-xs) 0 0;
  }

  /* ---- demo disclosure (#80): sits directly above "Place order" and above
     the tracker's Delivered-state rating prompt ---- */

  .demo-disclosure {
    display: flex;
    gap: var(--space-xs);
    align-items: flex-start;
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
    padding: var(--space-xs) var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    font-size: var(--font-size-muted);
  }

  .demo-disclosure .icon-info {
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 1px;
    color: var(--color-text-muted);
  }

  .demo-disclosure a {
    color: var(--color-accent-a);
    font-weight: 700;
  }

  .place-order {
    display: block;
    width: 100%;
    min-height: 48px;
    padding: var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-body);
    font-weight: 800;
    text-align: center;
    text-decoration: none;
    color: var(--color-bg);
    background: var(--color-accent-a);
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: transform 100ms ease-out;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
  }

  .place-order:active {
    transform: scale(0.98);
  }

  .place-order:disabled {
    opacity: 0.6;
    cursor: default;
  }

  /* ---- Offers screen (#87/#89): checkbox vouchers, one section per stack-
     group qualification state, the tier-unlock sweep, the sticky footer —
     docs/design/87-offers-hcmc.html, rendered at runtime by offers-dom.ts
     into #offers-root, which gets no scoped <style> of its own (same
     unscoped-by-necessity pattern as the home feed above). */

  .top-bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .back {
    flex: none;
    width: 44px;
    height: 44px;
    padding: var(--space-sm);
    color: var(--color-text);
    background: none;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .subtotal-line {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-md);
  }

  .section-title {
    font-size: var(--font-size-muted);
    font-weight: 700;
    color: var(--color-text-muted);
    margin: var(--space-md) 0 var(--space-xs);
  }

  .voucher-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .voucher-row {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
  }

  .voucher-row.qualified {
    border-color: var(--color-accent-a);
  }

  .voucher-row.greyed {
    background: transparent;
  }

  /* The tier-unlock moment (#87): a 320ms color/border transition plus one
     480ms highlight sweep that doesn't repeat. Applied only when the row
     just became qualifying and offers-dom.ts's own prefersReducedMotion()
     check is false, so the reduced-motion branch is an instant state change
     by simply never gaining this class, not a media-query override. */
  .voucher-row-unlocking {
    transition:
      border-color 320ms cubic-bezier(0.22, 1, 0.36, 1),
      background 320ms cubic-bezier(0.22, 1, 0.36, 1);
    animation: voucher-unlock-sweep 480ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes voucher-unlock-sweep {
    from {
      box-shadow: inset 0 0 0 999px rgba(108, 60, 224, 0.18);
    }
    to {
      box-shadow: inset 0 0 0 999px rgba(108, 60, 224, 0);
    }
  }

  .badge {
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--color-accent-b);
    color: var(--color-badge-ink);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .voucher-row.greyed .badge {
    background: var(--color-border);
    color: var(--color-text-muted);
  }

  .badge svg {
    width: 18px;
    height: 18px;
  }

  .voucher-main {
    flex: 1;
    min-width: 0;
  }

  .voucher-amount {
    font-weight: 800;
    font-size: var(--font-size-body);
    margin: 0;
  }

  .voucher-row.greyed .voucher-amount {
    color: var(--color-text-muted);
    font-weight: 700;
  }

  .flash-tag {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 800;
    color: #fff;
    background: var(--color-accent-a);
    border-radius: 4px;
    padding: 0 4px;
    margin-left: var(--space-xs);
    vertical-align: 2px;
  }

  .voucher-min {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    margin: 2px 0 0;
  }

  .voucher-expiry {
    display: flex;
    align-items: center;
    gap: 3px;
    font-size: var(--font-size-muted);
    color: var(--color-accent-b);
    margin: 3px 0 0;
    font-weight: 700;
  }

  .voucher-row.greyed .voucher-expiry {
    color: var(--color-text-muted);
  }

  .voucher-expiry svg {
    flex: none;
    width: 13px;
    height: 13px;
  }

  .voucher-nudge {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    margin: var(--space-xs) 0 0;
  }

  .checkbox {
    appearance: none;
    -webkit-appearance: none;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    border: 2px solid var(--color-accent-a);
    margin: 2px 0 0;
    position: relative;
    background: transparent;
  }

  .checkbox:checked {
    background: var(--color-accent-a);
  }

  .checkbox:checked::after {
    content: '';
    position: absolute;
    left: 5px;
    top: 2px;
    width: 7px;
    height: 11px;
    border-bottom: 2px solid #fff;
    border-right: 2px solid #fff;
    transform: rotate(40deg);
  }

  .checkbox:disabled {
    border-color: var(--color-border);
  }

  .footer-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-sm) var(--space-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .footer-saved {
    font-weight: 800;
    color: var(--color-accent-a);
    font-size: var(--font-size-body);
  }

  .footer-apply {
    border: none;
    border-radius: 10px;
    background: var(--color-accent-a);
    color: #fff;
    font-weight: 800;
    font-size: var(--font-size-body);
    min-height: 44px;
    padding: 0 var(--space-lg);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* Below 480px the sitewide tab bar (Header.astro) is itself fixed to the
     viewport bottom — offset this sheet's own fixed footer above it rather
     than stacking the two, and give #offers-root enough bottom padding that
     the last voucher row never renders underneath either bar. */
  @media (max-width: 480px) {
    .footer-bar {
      bottom: calc(56px + env(safe-area-inset-bottom));
    }

    #offers-root {
      display: block;
      padding-bottom: calc(60px + var(--space-md));
    }
  }

  /* ---- flash-deal sheet (#87/#89, grown to #119/#120's Grab-sized sheet):
     drag handle, a full-bleed header (amount + live mm:ss countdown) over
     the min-spend line, then 5–6 deal restaurants scrolling inside the
     sheet's own ~88vh while the header stays put — docs/design/
     119-flash-sheet-open-hcmc.html, rendered by flash-sheet-dom.ts. */

  .flash-sheet-overlay {
    position: fixed;
    inset: 0;
    z-index: 20;
  }

  .flash-sheet-overlay .scrim {
    position: fixed;
    inset: 0;
    background: rgba(36, 27, 51, 0.45);
    border: none;
    padding: 0;
  }

  /* 88vh rather than a pixel guess: a percentage of the viewport height
     directly produces "roughly 85-90% at 375px" at any viewport (#119's own
     mock rationale). overflow:hidden so the sheet's own rounded top corners
     clip the header's full-bleed color block. */
  .flash-sheet-overlay .sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    max-width: 26rem;
    margin: 0 auto;
    height: 88vh;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border-radius: 12px 12px 0 0;
    box-shadow: 0 -8px 24px rgba(36, 27, 51, 0.18);
    overflow: hidden;
  }

  .flash-sheet-overlay .drag-handle {
    flex: none;
    display: block;
    width: 40px;
    height: 4px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: var(--color-border);
    margin: var(--space-sm) auto;
  }

  .flash-sheet-overlay .sheet-close {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-lg);
    width: 24px;
    height: 24px;
    padding: 0;
    border: none;
    background: none;
    color: var(--color-text-muted);
  }

  /* Full-bleed, no side inset — a colour block spanning the sheet's whole
     width, not the old inset card-style header (#119). */
  .flash-sheet-overlay .sheet-header {
    flex: none;
    background: var(--color-accent-a);
    color: #fff;
    padding: var(--space-md) var(--space-lg) var(--space-lg);
  }

  .flash-sheet-overlay .sheet-header h1 {
    margin: 0 0 var(--space-md);
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .flash-sheet-overlay .countdown {
    display: flex;
    gap: var(--space-sm);
  }

  .flash-sheet-overlay .countdown .tile {
    background: var(--color-text);
    color: #ffffff;
    border-radius: 10px;
    min-width: 44px;
    padding: var(--space-xs) var(--space-sm);
    font-size: 1.25rem;
    font-weight: 800;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .flash-sheet-overlay .countdown .tile-sep {
    color: #fff;
    font-weight: 800;
    font-size: 1.25rem;
    align-self: center;
  }

  .flash-sheet-overlay .min-spend-line {
    flex: none;
    text-align: center;
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    padding: var(--space-md) var(--space-lg);
  }

  /* The only region that scrolls — the header and min-spend line above it
     are flex siblings that never move (#119's "fixed header, scrolling
     list" split). Its own class, not home-dom.ts's `.restaurant-list`,
     whose global margin/gap rule (line ~253) would otherwise leak in. */
  .flash-sheet-overlay .deal-list {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    padding: 0 var(--space-lg) var(--space-lg);
  }

  .flash-sheet-overlay .restaurant-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    width: 100%;
    padding: var(--space-md) 0;
    border-top: 1px solid var(--color-border);
    background: none;
    border-left: none;
    border-right: none;
    border-bottom: none;
    text-align: left;
    font-family: inherit;
    color: var(--color-text);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .flash-sheet-overlay .restaurant-row:first-of-type {
    border-top: none;
  }

  .flash-sheet-overlay .restaurant-photo {
    position: relative;
    flex: none;
    width: 80px;
    height: 80px;
  }

  /* Radius on the image itself, not `overflow: hidden` on `.restaurant-photo`
     — that would also clip `.deal-sticker`'s intentional negative offset,
     cutting off the corner it's meant to overlap. */
  .flash-sheet-overlay .restaurant-photo img {
    width: 100%;
    height: 100%;
    border-radius: 10px;
    object-fit: cover;
  }

  .flash-sheet-overlay .deal-sticker {
    position: absolute;
    left: -4px;
    top: -4px;
    background: var(--color-accent-b);
    color: var(--color-badge-ink);
    font-size: 0.625rem;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 999px;
  }

  .flash-sheet-overlay .restaurant-main {
    flex: 1;
    min-width: 0;
    align-self: center;
  }

  /* One line, ellipsis-truncated (#119: no drawn name clips at 375px). */
  .flash-sheet-overlay .restaurant-name {
    font-weight: 700;
    margin: 0 0 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .flash-sheet-overlay .restaurant-meta {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    margin: 0 0 3px;
  }

  .flash-sheet-overlay .restaurant-fee {
    font-size: var(--font-size-muted);
    font-weight: 800;
    color: var(--color-accent-a);
    margin: 0;
  }

  .flash-sheet-overlay .restaurant-fee .original {
    color: var(--color-text-muted);
    font-weight: 500;
    text-decoration: line-through;
    margin-left: 4px;
  }

  /* ---- the collapsed reopen bar (#120): "{amount} off flash deals" plus a
     live mm:ss, pinned above the phone tab bar — docs/design/
     119-flash-bar-collapsed-hcmc.html. Fixed on every width (unlike
     .cart-summary-bar, phone-only) since there's no tab bar to clear above
     480px, matching .footer-bar's own pattern for the same reason. */

  .reopen-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 15;
    max-width: 26rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    background: var(--color-accent-a);
    color: #fff;
    border: none;
    border-radius: 12px 12px 0 0;
    padding: var(--space-md) var(--space-lg);
    font-family: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .reopen-bar .label {
    font-weight: 800;
    font-size: var(--font-size-body);
    text-align: left;
  }

  .reopen-bar .right {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex: none;
  }

  .reopen-bar .lightning {
    width: 18px;
    height: 18px;
    flex: none;
  }

  .reopen-bar .countdown {
    display: flex;
    gap: 4px;
  }

  .reopen-bar .tile {
    background: var(--color-text);
    color: #fff;
    border-radius: 10px;
    min-width: 30px;
    padding: 3px 5px;
    font-size: 0.8125rem;
    font-weight: 800;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .reopen-bar .tile-sep {
    color: #fff;
    font-weight: 800;
    font-size: 0.8125rem;
  }

  @media (max-width: 480px) {
    .reopen-bar {
      bottom: calc(56px + env(safe-area-inset-bottom));
    }
  }

  /* The home feed's own flash badge (#87/#89): an inline tag beside the
     restaurant meta line, distinct from .deal-badge's absolute corner
     sticker so the two never overlap when a restaurant carries both. */
  .flash-badge {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 800;
    color: #fff;
    background: var(--color-accent-a);
    border-radius: 4px;
    padding: 1px 4px;
    margin-left: var(--space-xs);
    vertical-align: 1px;
  }

  /* ---- order placed (#105: centered confirmation, 105-order-placed.html) ---- */

  .order-placed-wrap {
    text-align: center;
    padding-top: var(--space-lg);
  }

  .order-placed-wrap h1 {
    margin: 0 0 var(--space-sm);
  }

  .order-placed-wrap p {
    color: var(--color-text-muted);
    margin: 0 0 var(--space-lg);
  }

  .order-placed-badge {
    width: 72px;
    height: 72px;
    margin: 0 auto var(--space-lg);
    border-radius: 999px;
    background: var(--color-accent-a);
    color: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .order-placed-badge svg {
    width: 34px;
    height: 34px;
  }

  /* A distinct pill CTA rather than reusing .place-order (theme.build.test.ts
     locks that class to a full-width 12px-radius rectangle) — this mock
     draws a centered, inline pill instead. */
  .order-placed-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 var(--space-xl);
    border-radius: 999px;
    background: var(--color-accent-a);
    color: var(--color-bg);
    font-weight: 800;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* ---- tracker stepper ---- */

  /* #105's rail-and-dot reading (105-tracker.html), replacing #83's
     border-left-plus-pseudo-element dots with an explicit rail so each
     step's check icon has somewhere to sit — the class stays `.stepper`
     (theme.build.test.ts asserts a rule by that name) even though its
     internal shape has changed. */
  .stepper {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
  }

  .stepper li {
    display: flex;
    gap: var(--space-md);
  }

  .step-rail {
    flex: none;
    width: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .step-dot {
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    color: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step-dot svg {
    width: 12px;
    height: 12px;
  }

  .step-line {
    flex: 1;
    width: 2px;
    min-height: var(--space-lg);
    background: var(--color-border);
  }

  .stepper li:last-child .step-line {
    display: none;
  }

  .stepper li .step-label {
    padding: 1px 0 var(--space-lg);
    color: var(--color-text-muted);
  }

  .stepper li:last-child .step-label {
    padding-bottom: 0;
  }

  .stepper li.done .step-dot,
  .stepper li.current .step-dot {
    background: var(--color-accent-a);
    border-color: var(--color-accent-a);
  }

  .stepper li.current .step-dot {
    background: var(--color-accent-b);
    border-color: var(--color-accent-b);
  }

  .stepper li.done .step-line {
    background: var(--color-accent-a);
  }

  .stepper li.done .step-label,
  .stepper li.current .step-label {
    font-weight: 700;
    color: var(--color-text);
  }

  .tracker-summary {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-lg);
