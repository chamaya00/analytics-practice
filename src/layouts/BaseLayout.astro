---
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
  </head>
  <body>
    <Header currentPath={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <a href="/about/">What we log, and why</a>
    </footer>
  </body>
</html>

<script>
  import { initTracking } from '../lib/tracking-transport';

  initTracking();
</script>

<style is:global>
  /* Sitewide per docs/design/65-parody-flow.md's "Privacy note" section —
     same link text and destination as the checkout page's contextual one,
     so it reads as the same document found twice. Sits under the
     tab-bar-clearing padding main.astro already reserves at phone width. */
  .site-footer {
    max-width: 40rem;
    margin: 0 auto;
    padding: 0 var(--space-lg) var(--space-xl);
    text-align: center;
  }

  .site-footer a {
    color: var(--color-text-muted);
    font-size: var(--font-size-muted);
    letter-spacing: 0.05em;
  }

  /* main's own bottom padding (global.css) only clears the fixed tab bar for
     main's own content — the footer sits after it, so it needs the same
     clearance or the tab bar covers it at the bottom of the page. */
  @media (max-width: 480px) {
    .site-footer {
      padding-bottom: calc(56px + env(safe-area-inset-bottom) + var(--space-xl));
    }
  }

  /* Shared component styles for the Dontdropthatpromo parody
     (docs/design/65-parody-flow.md, docs/design/72-dontdropthatpromo-identity.md),
     used by more than one page's DOM module — lives here rather than
     duplicated per page, same reasoning as .reset-button in global.css. All
     tokens (spacing, color, type) are global.css's own, unchanged. */

  /* ---- landing: order-in-progress banner ---- */

  .order-banner {
    display: block;
    margin-bottom: var(--space-lg);
    padding: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-accent-a);
    color: var(--color-accent-a);
    font-weight: 700;
    text-decoration: none;
  }

  /* ---- home feed: location bar, search, promo banner, cuisine chips ----
     docs/design/80-two-city-brand-and-flow.md, screen 2 / 80-home-sf.html.
     Rendered by home-dom.ts into #home-root, which BaseLayout gives no
     scoped <style> of its own — these live here, unscoped, the same as
     every other DOM-module component below. */

  .location-bar {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: inherit;
    font-size: var(--font-size-muted);
    font-weight: 700;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: var(--space-xs) var(--space-md);
    min-height: 32px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .home-search {
    display: block;
    width: 100%;
    min-height: 44px;
    /* No margin-top: main's own padding-top (--space-xl) is the page's
       standard top clearance, same as every other page's first element.
       This used to carry its own var(--space-md) on top of that, a leftover
       from when the location pill sat above it in-feed — now that the pill
       lives in Header.astro (#137), that stacked to ~42px of dead space
       above the search field (driver review, PR #150 round 1, item 2). */
    padding: 0 var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-body);
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .home-search::placeholder {
    color: var(--color-text-muted);
  }

  /* ---- promo carousel (docs/design/137-carousel-header-tiles.md,
     "Promo carousel") — replaces the single .promo-banner slot, same
     position in the flow (between search and the cuisine chips). ---- */

  .carousel {
    margin-top: var(--space-md);
  }

  .carousel-slide-media {
    position: relative;
    height: 200px;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-surface);
  }

  /* The first-order slide hides .carousel-caption (home-dom.ts) rather than
     leaving it empty, so this grows by exactly that strip's own min-height
     (200px + 56px) — the slide's total height (media plus caption) then
     matches every other slide's, and .carousel-slide-panel's inset:0 fills
     the grown box (#151, driver review on PR #150 round 1). */
  .carousel-slide-media--first-order {
    height: 256px;
  }

  .carousel-slide-link {
    position: absolute;
    inset: 0;
    display: block;
    z-index: 1;
    -webkit-tap-highlight-color: transparent;
  }

  .carousel-slide-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The first-order slide's stand-in for a photo (home-dom.ts's
     renderCarousel) — the old .promo-banner's own surface/border/accent-text
     treatment, not a new tinted-alpha panel, so it needs no new contrast
     check: --color-accent-a on --color-surface is already the pairing
     contrast.test.ts's "accent clears 4.5:1 against both bg and surface"
     covers (driver review, PR #150 round 1, item 1). */
  .carousel-slide-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: var(--space-lg);
    text-align: center;
    background: var(--color-surface);
    border: 1px solid var(--color-accent-a);
    border-radius: 12px;
  }

  .carousel-slide-panel-claim {
    font-weight: 800;
    font-size: var(--font-size-h2);
    color: var(--color-accent-a);
  }

  .carousel-slide-panel-sub {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  /* Fixed dark scrim, deliberately not retheming (same reasoning as
     --color-flash-tile-bg below): it sits over unpredictable photo content,
     not the page's own background — contrast checked in the design doc
     (./scripts/contrast '#ffffff' '#1a1224' 4.5, 18.17:1). */
  .carousel-ad-label {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    z-index: 2;
    background: rgba(0, 0, 0, 0.72);
    color: #fff;
    font-size: 0.625rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 999px;
  }

  /* 44px hit area, invisible itself — the visible scrim disc is the smaller
     .carousel-pause-mark inside it, same split as .carousel-dot/
     .carousel-dot-mark below (driver review, PR #150 round 1, item 5: the
     mock's chip is much smaller than a 44px disc). */
  .carousel-pause {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .carousel-pause-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: rgba(0, 0, 0, 0.72);
    color: #fff;
    border-radius: 999px;
  }

  .carousel-pause-mark svg {
    width: 16px;
    height: 16px;
  }

  .carousel-caption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-sm) 0;
    /* Pinned to the design doc's own "caption strip" arithmetic (16px
       padding + 21px claim line + 2px gap + 17px sub line = 56px) so the
       first-order slide — whose claim/sub move into .carousel-slide-panel
       above and leave this strip's own text empty — doesn't shrink the
       slide shorter than every other slide. */
    min-height: 56px;
  }

  /* [hidden] is a browser default of display:none, but the flex rule above
     has higher specificity and overrides it — same gotcha as .cart-badge[hidden]
     in Header.astro. Without this, the first-order slide's hidden-but-flexed
     caption still reserves an empty 56px band. */
  .carousel-caption[hidden] {
    display: none;
  }

  .carousel-claim {
    font-weight: 800;
    font-size: var(--font-size-body);
    color: var(--color-text);
  }

  .carousel-sub {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: var(--space-xs);
  }

  /* 44px-tall hit area, but narrow rather than square (24px, the mock's own
     compact centred row) so 7 of them don't spread across the row's full
     width (driver review, PR #150 round 1, item 4). */
  .carousel-dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    min-height: 44px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .carousel-dot-mark {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-border);
  }

  .carousel-dot.is-current .carousel-dot-mark {
    width: 8px;
    height: 8px;
    background: var(--color-accent-a);
  }

  .cuisine-chips {
    margin-top: var(--space-md);
    display: flex;
    gap: var(--space-sm);
    overflow-x: auto;
    -webkit-mask-image: linear-gradient(to right, black 88%, transparent);
    mask-image: linear-gradient(to right, black 88%, transparent);
    padding-right: var(--space-lg);
  }

  .cuisine-chip {
    flex: none;
    min-height: 36px;
    display: flex;
    align-items: center;
    padding: 0 var(--space-md);
    font-family: inherit;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    font-size: var(--font-size-muted);
    font-weight: 700;
    color: var(--color-text-muted);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .cuisine-chip.selected {
    color: var(--color-accent-a);
    border-color: var(--color-accent-a);
  }

  /* Home feed's "Near you" heading (#80/#104: docs/design/80-home-sf.html's
     h2.section-title) — its own class rather than the Offers screen's
     .section-title (defined further below), which is deliberately smaller
     and muted rather than this compact-page-title scale. */
  .home-section-title {
    font-size: var(--font-size-h2);
    font-weight: 700;
    margin: var(--space-lg) 0 var(--space-sm);
  }

  /* ---- location picker (home screen 1) ---- */

  .location-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .location-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    padding: var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-body);
    color: var(--color-text);
    text-align: left;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .location-card img {
    border-radius: 8px;
    object-fit: cover;
  }

  .location-card-name {
    font-weight: 800;
  }

  .location-card-currency {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .location-blocked-notice {
    margin-top: var(--space-md);
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  /* ---- "Near you": 2-column tile grid (docs/design/137-carousel-header-tiles.md,
     "Two-column tile grid") — replaces the old vertical .restaurant-list. ---- */

  .tile-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    margin: var(--space-md) 0 0;
    padding: 0;
  }

  /* ---- restaurant card: cart list (cart-dom.ts) and the flash sheet
     (flash-sheet-dom.ts) both still reuse this shape unchanged — the tile
     grid above gets its own .tile-card class below rather than restyling
     this one in place, which would silently restyle both (#137's own "For
     the engineer" note). ---- */

  .restaurant-card {
    position: relative;
    display: flex;
    gap: var(--space-md);
    padding: var(--space-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    color: var(--color-text);
    text-decoration: none;
    transition: transform 100ms ease-out;
    /* docs/design/46-phone-native.md, Touch feedback: no default browser
       tap-highlight, no text selection or iOS link-preview callout on a
       long press — every touch target on this site follows it, not only
       the ones #46 itself introduced. */
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
  }

  .restaurant-card:active {
    transform: scale(0.98);
  }

  .restaurant-card-photo {
    flex: none;
    width: 72px;
    height: 72px;
    border-radius: 10px;
    object-fit: cover;
  }

  .restaurant-card-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-width: 0;
  }

  .restaurant-card-name {
    font-weight: 800;
  }

  .restaurant-card-tag,
  .restaurant-card-meta {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  /* ---- tile card: the "Near you" grid's own card, a new class rather
     than a restyle of .restaurant-card above (see that block's own note). ---- */

  .tile-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    color: var(--color-text);
    text-decoration: none;
    transition: transform 100ms ease-out;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
  }

  .tile-card:active {
    transform: scale(0.98);
  }

  .tile-card-photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .tile-card-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-sm);
    min-width: 0;
  }

  .tile-card-name {
    font-weight: 800;
  }

  .tile-card-rating,
  .tile-card-meta {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  /* The fee and "delivery" as one non-wrapping unit — the tile grid's
     columns are narrower than the full-width rows #130 fixed this on, so
     that fix (moving content off the line) isn't enough room here; a plain
     text node still breaks between "$1.99" and "delivery" and leaves
     "delivery" alone on its own line (#151). */
  .tile-card-fee {
    white-space: nowrap;
  }

  /* The city vehicle icon beside every delivery estimate (#130) — sized in
     `em` so it scales with the line it sits in (round 1 review, item 2: a
     fixed 14px read as a speck next to the tracker's large bold countdown
     text). Centred on the text via vertical-align, with the gap to the text
     that follows coming from this one margin — round 1 review, item 3: a
     literal leading space in the text after the icon, on top of this
     margin, read as two spaces. */
  .vehicle-icon {
    flex: none;
    width: 1.2em;
    height: 1.2em;
    vertical-align: -0.25em;
    margin-right: 0.3em;
  }

  .deal-badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    background: var(--color-accent-b);
    color: var(--color-badge-ink);
    font-size: 0.625rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 999px;
  }

  /* ---- menu / cart line items, shared shape ---- */

  .menu-list,
  .cart-list {
    list-style: none;
    margin: 0 0 var(--space-lg);
    padding: 0;
  }

  .menu-item-row,
  .cart-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
  }

  /* ---- cart row: swipe left to reveal "Remove" (swipe-row.ts) ----
     Two layers in one clipped row: .swipe-action pinned to the trailing
     edge, and the line's own content (.cart-line) on top of it with an
     opaque background. A left drag moves the content; .is-open parks it
     88px left (swipe-row.ts's SWIPE_OPEN_OFFSET_PX), uncovering the action.
     touch-action: pan-y leaves vertical drags to the page's scroll, so
     only a sideways drag becomes a swipe.

     The row bleeds into main's own side padding (exactly var(--space-lg),
     global.css) and pads itself back in by the same amount, so the clip
     edge is the screen edge: sliding content leaves the screen rather than
     being cut mid-word at the text column. The divider stays on the text
     column via ::after. */
  .cart-row {
    position: relative;
    overflow: hidden;
    margin: 0 calc(-1 * var(--space-lg));
    padding: 0 var(--space-lg);
  }

  .cart-row::after {
    content: '';
    position: absolute;
    left: var(--space-lg);
    right: var(--space-lg);
    bottom: 0;
    z-index: 2;
    border-bottom: 1px solid var(--color-border);
    pointer-events: none;
  }

  .cart-row > .cart-line {
    position: relative;
    z-index: 1;
    flex-wrap: nowrap;
    border-bottom: none;
    background: var(--color-bg);
    touch-action: pan-y;
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
  }

  .cart-row.is-open > .cart-line {
    transform: translateX(-88px);
  }

  /* While a finger is down the content follows it exactly — no easing
     lagging behind the drag. */
  .cart-row.is-dragging > .cart-line {
    transition: none;
  }

  .swipe-action {
    position: absolute;
    top: var(--space-sm);
    bottom: var(--space-sm);
    right: var(--space-lg);
    width: 80px;
    padding: 0;
    font-family: inherit;
    font-size: var(--font-size-muted);
    font-weight: 800;
    color: var(--color-bg);
    background: var(--color-danger);
    border: none;
    border-radius: 12px;
    cursor: pointer;
    /* #105's icon-plus-label reading (105-cart-single-sf.html): "Remove"
       reads from its own trash icon and weight, not the red fill alone. */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
  }

  .swipe-action svg {
    width: 18px;
    height: 18px;
  }

  .swipe-action:active {
    transform: scale(0.97);
  }

  .cart-line-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    /* Without this the column's default stretch would give the stepper
       pill (an inline-flex item here, not a block) the row's full width
       instead of sizing to its own content (105-cart-single-sf.html). */
    align-items: flex-start;
    gap: 2px;
  }

  .cart-line-name {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  /* 84px/10px radius, matching the home feed's own restaurant-card thumbnail
     treatment (#105: criterion 2) — shared by the menu's dish rows and the
     cart's line-item rows below, not a separate class per screen. */
  .menu-item-photo {
    flex: none;
    width: 84px;
    height: 84px;
    border-radius: 10px;
    object-fit: cover;
  }

  /* The dish name, description and price sit in their own wrapping element
     (menu-dom.ts's textWrap) rather than being direct .menu-item-row
     children like .cart-line-name above — stacked here rather than left to
     fall onto one run-together line (driver review, #82 round 1, item 4). */
  .menu-item-text {
    flex: 1;
    min-width: 8rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .menu-item-name {
    font-weight: 700;
  }

  .menu-item-description {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .menu-item-price,
  .cart-line-total {
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  /* #105: a rounded pill container with two filled circular buttons — the
     mocks' own stepper shape (105-menu-sf.html, 105-cart-single-sf.html),
     replacing the bordered-square buttons #104 left behind on this
     component. */
  .quantity-stepper {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 36px;
    padding: 0 var(--space-sm);
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-accent-a);
  }

  .quantity-stepper button {
    width: 22px;
    height: 22px;
    font-family: inherit;
    font-weight: 800;
    line-height: 1;
    color: var(--color-bg);
    background: var(--color-accent-a);
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .quantity-count {
    min-width: 1.5rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .add-button {
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-body);
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    -webkit-tap-highlight-color: transparent;
  }

  /* #105's CartSummaryBar: fixed above the phone tab bar (105-menu-sf.html's
     .cart-summary-bar), a plain rounded bar at the foot of content on
     desktop where there is no tab bar to clear. */
  .cart-summary-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-accent-a);
    color: var(--color-bg);
    text-decoration: none;
  }

  .cart-summary-bar .summary-text {
    font-size: var(--font-size-muted);
    font-weight: 700;
  }

  .cart-summary-bar .view-cart {
    font-weight: 800;
  }

  @media (max-width: 480px) {
    .cart-summary-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: calc(56px + env(safe-area-inset-bottom));
    }
  }

  @media (min-width: 481px) {
    .cart-summary-bar {
      border-radius: 12px;
      margin-top: var(--space-lg);
    }
  }

  /* ---- "Your carts": one card per restaurant (cart-dom.ts) ----
     Every restaurant is its own cart, so with several the Cart tab lists
     them rather than merging them. Each card reuses the home feed's
     .restaurant-card shape (and its touch feedback) with a smaller photo and
     the cart's own subtotal on the trailing edge. */

  .cart-list-note {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .cart-cards {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin: 0 0 var(--space-lg);
    padding: 0;
  }

  .cart-card {
    align-items: center;
  }

  .cart-card .cart-card-photo {
    width: 56px;
    height: 56px;
  }

  .cart-card-subtotal {
    flex: none;
    margin-left: auto;
    padding-right: var(--space-xs);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  /* One restaurant's cart and the Offers screen both head the page with a
     back chevron beside the title; the title sits on the chevron's centre
     line rather than carrying its usual bottom margin inside the row. */
  .top-bar h1 {
    margin: 0;
    min-width: 0;
  }

  a.back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .back svg {
    display: block;
    width: 24px;
    height: 24px;
  }

  .checkout-restaurant {
    margin: 0 0 var(--space-sm);
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  /* 105-cart-single-sf.html's breakdown-preview: Subtotal and Delivery fee
     as .breakdown-row label/value lines (Checkout's own shape), not bold
     "Subtotal: $X" text. */
  .cart-breakdown {
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .cart-fee-note {
    margin-top: 0;
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  /* ---- remove-confirm dialog (confirm-dialog-dom.ts): the cart stepper's
     minus at quantity 1 ---- */

  .confirm-overlay {
    position: fixed;
    inset: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-lg);
  }

  .confirm-scrim {
    position: fixed;
    inset: 0;
    background: rgba(36, 27, 51, 0.45);
  }

  .confirm-dialog {
    position: relative;
    width: 100%;
    max-width: 22rem;
    padding: var(--space-lg);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    /* #105's own critique caught a one-off 16px on this sheet and corrected
       it to the system's own 12px card radius (105-cart-remove-modal.html). */
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(36, 27, 51, 0.18);
    animation: confirm-in 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes confirm-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .confirm-title {
    margin: 0 0 var(--space-xs);
    font-size: var(--font-size-h2);
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .confirm-body {
    margin: 0 0 var(--space-lg);
    color: var(--color-text-muted);
  }

  .confirm-actions {
    display: flex;
    gap: var(--space-sm);
  }

  .confirm-button {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 0 var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-body);
    font-weight: 800;
    border-radius: 999px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
  }

  .confirm-button:active {
    transform: scale(0.97);
  }

  .confirm-button:focus-visible,
  .swipe-action:focus-visible {
    outline: 2px solid var(--color-accent-a);
    outline-offset: 2px;
  }

  .confirm-cancel {
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .confirm-danger {
    color: var(--color-bg);
    background: var(--color-danger);
    border: 1px solid var(--color-danger);
  }

  /* Checkout and Offers both put their own page title directly under the
     wordmark, the same as the home feed above — their mocks (80-checkout-
     hcmc.html, 87-offers-hcmc.html) give main a --space-md top padding,
     against this site's default --space-xl, so the gap above "Checkout" /
     "Offers" at phone width reads about twice the mock's own (driver review,
     #107 round 1, item 2). */
  @media (max-width: 480px) {
    main:has(#checkout-root),
    main:has(#offers-root) {
      padding-top: var(--space-md);
    }
  }

  /* ---- checkout fields: preset choices only, nothing typed ---- */

  .checkout-field {
    margin-bottom: var(--space-sm);
  }

  .mini-field {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .mini-label {
    font-size: var(--font-size-muted);
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .chip-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .chip {
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-muted);
    font-weight: 600;
    line-height: 1.15;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .chip.selected {
    color: var(--color-accent-a);
    border-color: var(--color-accent-a);
    font-weight: 800;
  }

  /* The mock's right-aligned toggle pair sits smaller than the preset
     chip-groups above it (docs/design/80-checkout-hcmc.html's .toggle). */
  .mini-field .chip-group {
    gap: var(--space-xs);
  }

  .mini-field .chip {
    min-height: 32px;
    padding: 0 var(--space-sm);
  }

  .privacy-note {
    margin: 0 0 var(--space-lg);
  }

  .privacy-note a {
    color: var(--color-text-muted);
    font-size: var(--font-size-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* ---- checkout price breakdown (#80: Subtotal, Delivery fee, Service fee,
     Total — #89 adds Discount/"You saved" lines to this same block) ---- */

  .checkout-breakdown {
    margin: var(--space-md) 0;
    padding-top: var(--space-xs);
    border-top: 1px solid var(--color-border);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
    padding: var(--space-xs) 0;
  }

  .breakdown-row .muted {
    color: var(--color-text-muted);
  }

  .breakdown-row.total {
    font-weight: 800;
    font-size: var(--font-size-h2);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-xs);
    padding-top: var(--space-sm);
  }

  /* #87/#89: the delivery-fee row's struck-through original next to "Free"
     or the reduced flash price, the Discount row, and the "You saved"
     sub-line — docs/design/80-checkout-hcmc.html's own breakdown block. */
  .breakdown-row .struck {
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .breakdown-row .free {
    color: var(--color-accent-a);
    font-weight: 800;
  }

  .breakdown-row.discount {
    color: var(--color-accent-a);
    font-weight: 800;
  }

  .breakdown-row.discount .icon-tag {
    flex: none;
    width: 16px;
    height: 16px;
    vertical-align: -3px;
    margin-right: 4px;
    color: var(--color-accent-a);
  }

  .saved-line {
    font-size: var(--font-size-muted);
    font-weight: 800;
    color: var(--color-accent-a);
    text-align: right;
    margin: -2px 0 var(--space-xs);
  }

  /* #87/#89: checkout's Offers row, replacing the old promo chip group. */
  .offers-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    width: 100%;
    margin-top: var(--space-sm);
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    border-left: none;
    border-right: none;
    font-family: inherit;
    font-size: var(--font-size-body);
    text-align: left;
    color: var(--color-text);
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .offers-row .label {
    font-weight: 700;
  }

  .offers-row .summary {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: var(--font-size-muted);
    color: var(--color-accent-a);
    font-weight: 700;
  }

  .offers-row .chevron {
    flex: none;
    width: 14px;
    height: 14px;
  }

  .offers-drop-notice {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    margin: var(--space-xs) 0 0;
  }

  /* ---- demo disclosure (#80): sits directly above "Place order" and above
     the tracker's Delivered-state rating prompt ---- */

  .demo-disclosure {
    display: flex;
    gap: var(--space-xs);
    align-items: flex-start;
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
    padding: var(--space-xs) var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    font-size: var(--font-size-muted);
  }

  .demo-disclosure .icon-info {
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 1px;
    color: var(--color-text-muted);
  }

  .demo-disclosure a {
    color: var(--color-accent-a);
    font-weight: 700;
  }

  .place-order {
    display: block;
    width: 100%;
    min-height: 48px;
    padding: var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-body);
    font-weight: 800;
    text-align: center;
    text-decoration: none;
    color: var(--color-bg);
    background: var(--color-accent-a);
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: transform 100ms ease-out;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
  }

  .place-order:active {
    transform: scale(0.98);
  }

  .place-order:disabled {
    opacity: 0.6;
    cursor: default;
  }

  /* ---- Offers screen (#87/#89): checkbox vouchers, one section per stack-
     group qualification state, the tier-unlock sweep, the sticky footer —
     docs/design/87-offers-hcmc.html, rendered at runtime by offers-dom.ts
     into #offers-root, which gets no scoped <style> of its own (same
     unscoped-by-necessity pattern as the home feed above). */

  .top-bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .back {
    flex: none;
    width: 44px;
    height: 44px;
    padding: var(--space-sm);
    color: var(--color-text);
    background: none;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .subtotal-line {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-md);
  }

  .section-title {
    font-size: var(--font-size-muted);
    font-weight: 700;
    color: var(--color-text-muted);
    margin: var(--space-md) 0 var(--space-xs);
  }

  .voucher-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .voucher-row {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
  }

  .voucher-row.qualified {
    border-color: var(--color-accent-a);
  }

  .voucher-row.greyed {
    background: transparent;
  }

  /* The tier-unlock moment (#87): a 320ms color/border transition plus one
     480ms highlight sweep that doesn't repeat. Applied only when the row
     just became qualifying and offers-dom.ts's own prefersReducedMotion()
     check is false, so the reduced-motion branch is an instant state change
     by simply never gaining this class, not a media-query override. */
  .voucher-row-unlocking {
    transition:
      border-color 320ms cubic-bezier(0.22, 1, 0.36, 1),
      background 320ms cubic-bezier(0.22, 1, 0.36, 1);
    animation: voucher-unlock-sweep 480ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes voucher-unlock-sweep {
    from {
      box-shadow: inset 0 0 0 999px rgba(108, 60, 224, 0.18);
    }
    to {
      box-shadow: inset 0 0 0 999px rgba(108, 60, 224, 0);
    }
  }

  .badge {
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--color-accent-b);
    color: var(--color-badge-ink);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .voucher-row.greyed .badge {
    background: var(--color-border);
    color: var(--color-text-muted);
  }

  .badge svg {
    width: 18px;
    height: 18px;
  }

  .voucher-main {
    flex: 1;
    min-width: 0;
  }

  .voucher-amount {
    font-weight: 800;
    font-size: var(--font-size-body);
    margin: 0;
  }

  .voucher-row.greyed .voucher-amount {
    color: var(--color-text-muted);
    font-weight: 700;
  }

  .flash-tag {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 800;
    color: #fff;
    background: var(--color-accent-a);
    border-radius: 4px;
    padding: 0 4px;
    margin-left: var(--space-xs);
    vertical-align: 2px;
  }

  .voucher-min {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    margin: 2px 0 0;
  }

  .voucher-expiry {
    display: flex;
    align-items: center;
    gap: 3px;
    font-size: var(--font-size-muted);
    color: var(--color-accent-b);
    margin: 3px 0 0;
    font-weight: 700;
  }

  .voucher-row.greyed .voucher-expiry {
    color: var(--color-text-muted);
  }

  .voucher-expiry svg {
    flex: none;
    width: 13px;
    height: 13px;
  }

  .voucher-nudge {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    margin: var(--space-xs) 0 0;
  }

  .checkbox {
    appearance: none;
    -webkit-appearance: none;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    border: 2px solid var(--color-accent-a);
    margin: 2px 0 0;
    position: relative;
    background: transparent;
  }

  .checkbox:checked {
    background: var(--color-accent-a);
  }

  .checkbox:checked::after {
    content: '';
    position: absolute;
    left: 5px;
    top: 2px;
    width: 7px;
    height: 11px;
    border-bottom: 2px solid #fff;
    border-right: 2px solid #fff;
    transform: rotate(40deg);
  }

  .checkbox:disabled {
    border-color: var(--color-border);
  }

  .footer-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-sm) var(--space-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .footer-saved {
    font-weight: 800;
    color: var(--color-accent-a);
    font-size: var(--font-size-body);
  }

  .footer-apply {
    border: none;
    border-radius: 10px;
    background: var(--color-accent-a);
    color: #fff;
    font-weight: 800;
    font-size: var(--font-size-body);
    min-height: 44px;
    padding: 0 var(--space-lg);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* Below 480px the sitewide tab bar (Header.astro) is itself fixed to the
     viewport bottom — offset this sheet's own fixed footer above it rather
     than stacking the two, and give #offers-root enough bottom padding that
     the last voucher row never renders underneath either bar. */
  @media (max-width: 480px) {
    .footer-bar {
      bottom: calc(56px + env(safe-area-inset-bottom));
    }

    #offers-root {
      display: block;
      padding-bottom: calc(60px + var(--space-md));
    }
  }

  /* ---- flash-deal sheet (#87/#89, grown to #119/#120's Grab-sized sheet):
     drag handle, a full-bleed header (amount + live mm:ss countdown) over
     the min-spend line, then 5–6 deal restaurants scrolling inside the
     sheet's own ~88vh while the header stays put — docs/design/
     119-flash-sheet-open-hcmc.html, rendered by flash-sheet-dom.ts. */

  .flash-sheet-overlay {
    position: fixed;
    inset: 0;
    z-index: 20;
  }

  .flash-sheet-overlay .scrim {
    position: fixed;
    inset: 0;
    background: rgba(36, 27, 51, 0.45);
    border: none;
    padding: 0;
  }

  /* 88vh rather than a pixel guess: a percentage of the viewport height
     directly produces "roughly 85-90% at 375px" at any viewport (#119's own
     mock rationale). overflow:hidden so the sheet's own rounded top corners
     clip the header's full-bleed color block. */
  .flash-sheet-overlay .sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    max-width: 26rem;
    margin: 0 auto;
    height: 88vh;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border-radius: 12px 12px 0 0;
    box-shadow: 0 -8px 24px rgba(36, 27, 51, 0.18);
    overflow: hidden;
    /* Snap back to rest after a short drag (#126 AC1) — removed while
       dragging (`.is-dragging`, flash-sheet-dom.ts's attachSheetDragTrigger)
       so the sheet follows the finger with no lag, and removed altogether
       under reduced motion below. */
    transition: transform 200ms ease-out;
  }

  .flash-sheet-overlay .sheet.is-dragging {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .flash-sheet-overlay .sheet {
      transition: none;
    }
  }

  /* Full-width, 44px-tall hit area (#126 AC1) around a visibly larger
     40×5px bar — the hit area used to be the bar itself, at 40×4px, which
     is why a swipe landing anywhere else on it did nothing. */
  .flash-sheet-overlay .drag-handle {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    padding: 0;
    border: none;
    background: none;
    touch-action: none;
  }

  .flash-sheet-overlay .drag-handle-bar {
    width: 40px;
    height: 5px;
    border-radius: 999px;
    background: var(--color-border);
  }

  /* A 36px circle on a 44px hit area, inside the header's own corner
     rather than straddling its seam (#126 AC2). `.sheet-close-fill` is a
     separate layer so its opacity doesn't also fade the icon on top of
     it — both read `currentColor` from `.sheet-close`, which inherits the
     header's own text colour below. */
  .flash-sheet-overlay .sheet-close {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: none;
    color: inherit;
  }

  .flash-sheet-overlay .sheet-close-fill {
    position: absolute;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.16;
  }

  .flash-sheet-overlay .sheet-close svg {
    position: relative;
    width: 20px;
    height: 20px;
  }

  .flash-sheet-overlay .sheet-close:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  /* Full-bleed, no side inset — a colour block spanning the sheet's whole
     width, not the old inset card-style header (#119). Text colour is
     --color-bg rather than a fixed white: contrastRatio(--color-bg,
     --color-accent-a) already clears 4.5:1 in both themes (contrast.test.ts,
     "the accent ... clears 4.5:1 against both bg and surface"), and this is
     the same pairing .place-order uses on the same fill. Fixed white failed
     in dark mode, where --color-accent-a turns light lavender (#126 AC3). */
  .flash-sheet-overlay .sheet-header {
    position: relative;
    flex: none;
    background: var(--color-accent-a);
    color: var(--color-bg);
    padding: var(--space-md) var(--space-xxl) var(--space-lg) var(--space-lg);
    touch-action: none;
  }

  .flash-sheet-overlay .sheet-header h1 {
    margin: 0 0 4px;
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: inherit;
  }

  .flash-sheet-overlay .sheet-subtitle {
    margin: 0 0 var(--space-md);
    font-size: var(--font-size-muted);
    font-weight: 700;
    color: inherit;
  }

  .flash-sheet-overlay .countdown-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .flash-sheet-overlay .countdown-label {
    font-size: var(--font-size-muted);
    font-weight: 700;
    color: inherit;
  }

  .flash-sheet-overlay .countdown {
    display: flex;
    gap: var(--space-sm);
  }

  /* Always a dark tile with light digits, in both themes (#126 AC3) — not
     --color-text, which flips light in dark mode and made both digits and
     tile nearly invisible against each other. --color-flash-tile-bg
     (global.css) is deliberately not redeclared in the dark-mode block for
     this reason; contrastRatio('#ffffff', that fixed value) is checked in
     contrast.test.ts once, not per-theme, since the pairing never changes
     with the theme. */
  .flash-sheet-overlay .countdown .tile {
    background: var(--color-flash-tile-bg);
    color: #ffffff;
    border-radius: 10px;
    min-width: 44px;
    padding: var(--space-xs) var(--space-sm);
    font-size: 1.25rem;
    font-weight: 800;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .flash-sheet-overlay .countdown .tile-sep {
    color: inherit;
    font-weight: 800;
    font-size: 1.25rem;
    align-self: center;
  }

  /* The only region that scrolls — the header above it is a flex sibling
     that never moves (#119's "fixed header, scrolling list" split). Its
     own class, not home-dom.ts's `.tile-grid` (formerly `.restaurant-list`),
     whose global grid/gap rule would otherwise leak in. */
  .flash-sheet-overlay .deal-list {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    padding: 0 var(--space-lg) var(--space-lg);
  }

  .flash-sheet-overlay .restaurant-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    width: 100%;
    padding: var(--space-md) 0;
    border-top: 1px solid var(--color-border);
    background: none;
    border-left: none;
    border-right: none;
    border-bottom: none;
    text-align: left;
    font-family: inherit;
    color: var(--color-text);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .flash-sheet-overlay .restaurant-row:first-of-type {
    border-top: none;
  }

  .flash-sheet-overlay .restaurant-photo {
    position: relative;
    flex: none;
    width: 80px;
    height: 80px;
  }

  /* Radius on the image itself, not `overflow: hidden` on `.restaurant-photo`
     — that would also clip `.deal-sticker`'s intentional negative offset,
     cutting off the corner it's meant to overlap. */
  .flash-sheet-overlay .restaurant-photo img {
    width: 100%;
    height: 100%;
    border-radius: 10px;
    object-fit: cover;
  }

  .flash-sheet-overlay .deal-sticker {
    position: absolute;
    left: -4px;
    top: -4px;
    background: var(--color-accent-b);
    color: var(--color-badge-ink);
    font-size: 0.625rem;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 999px;
  }

  .flash-sheet-overlay .restaurant-main {
    flex: 1;
    min-width: 0;
    align-self: center;
  }

  /* One line, ellipsis-truncated (#119: no drawn name clips at 375px). */
  .flash-sheet-overlay .restaurant-name {
    font-weight: 700;
    margin: 0 0 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .flash-sheet-overlay .restaurant-meta {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    margin: 0 0 3px;
  }

  .flash-sheet-overlay .restaurant-fee {
    font-size: var(--font-size-muted);
    font-weight: 800;
    color: var(--color-accent-a);
    margin: 0;
  }

  .flash-sheet-overlay .restaurant-fee .original {
    color: var(--color-text-muted);
    font-weight: 500;
    text-decoration: line-through;
    margin-left: 4px;
  }

  /* ---- the collapsed reopen bar (#120): "{amount} off flash deals" plus a
     live mm:ss, pinned above the phone tab bar — docs/design/
     119-flash-bar-collapsed-hcmc.html. Fixed on every width (unlike
     .cart-summary-bar, phone-only) since there's no tab bar to clear above
     480px, matching .footer-bar's own pattern for the same reason. */

  .reopen-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 15;
    max-width: 26rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    background: var(--color-accent-a);
    /* --color-bg, not a fixed white — the same dark-mode contrast fix as
       the open sheet's own header (#126 AC3); see that rule's comment. */
    color: var(--color-bg);
    border: none;
    border-radius: 12px 12px 0 0;
    padding: var(--space-md) var(--space-lg);
    font-family: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* flex, not the plain single-line text this replaced: `gap` carries the
     visible spacing around the separator, since a flex item's own leading/
     trailing text-node whitespace collapses at its box edge. Each half gets
     its own `white-space: nowrap` below — flex's own nowrap default only
     stops items from moving to a new row, not a single item's own text from
     wrapping once its box is squeezed. The ≤480px query is what decides to
     break this onto two deliberate lines instead. */
  .reopen-bar .label {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    font-weight: 800;
    font-size: var(--font-size-body);
    text-align: left;
    color: inherit;
    min-width: 0;
  }

  .reopen-bar .label-deals,
  .reopen-bar .label-off {
    white-space: nowrap;
  }

  .reopen-bar .right {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex: none;
  }

  .reopen-bar .lightning {
    width: 18px;
    height: 18px;
    flex: none;
    color: inherit;
  }

  .reopen-bar .countdown-label {
    font-size: var(--font-size-muted);
    font-weight: 700;
    color: inherit;
  }

  .reopen-bar .countdown {
    display: flex;
    gap: 4px;
  }

  /* Always a dark tile with light digits, in both themes — the same fixed
     token as the open sheet's own countdown tile (#126 AC3). */
  .reopen-bar .tile {
    background: var(--color-flash-tile-bg);
    color: #fff;
    border-radius: 10px;
    min-width: 30px;
    padding: 3px 5px;
    font-size: 0.8125rem;
    font-weight: 800;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .reopen-bar .tile-sep {
    color: inherit;
    font-weight: 800;
    font-size: 0.8125rem;
    align-self: center;
  }

  @media (max-width: 480px) {
    .reopen-bar {
      bottom: calc(56px + env(safe-area-inset-bottom));
    }

    /* "Flash deals · 25.000 ₫ off" wraps into a dangling "·" on its own line
       at this width (review round 1 on #126). Two deliberate lines instead,
       with the separator hidden — it only makes sense read inline. The wider
       single-line form above keeps the separator. */
    .reopen-bar .label {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }

    .reopen-bar .label-sep {
      display: none;
    }
  }

  /* The home feed's own flash badge (#87/#89): an inline tag beside the
     restaurant meta line, distinct from .deal-badge's absolute corner
     sticker so the two never overlap when a restaurant carries both. */
  .flash-badge {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 800;
    color: #fff;
    background: var(--color-accent-a);
    border-radius: 4px;
    padding: 1px 4px;
    margin-left: var(--space-xs);
    vertical-align: 1px;
  }

  /* ---- order placed (#105: centered confirmation, 105-order-placed.html) ---- */

  .order-placed-wrap {
    text-align: center;
    padding-top: var(--space-lg);
  }

  .order-placed-wrap h1 {
    margin: 0 0 var(--space-sm);
  }

  .order-placed-wrap p {
    color: var(--color-text-muted);
    margin: 0 0 var(--space-lg);
  }

  .order-placed-badge {
    width: 72px;
    height: 72px;
    margin: 0 auto var(--space-lg);
    border-radius: 999px;
    background: var(--color-accent-a);
    color: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .order-placed-badge svg {
    width: 34px;
    height: 34px;
  }

  /* A distinct pill CTA rather than reusing .place-order (theme.build.test.ts
     locks that class to a full-width 12px-radius rectangle) — this mock
     draws a centered, inline pill instead. */
  .order-placed-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 var(--space-xl);
    border-radius: 999px;
    background: var(--color-accent-a);
    color: var(--color-bg);
    font-weight: 800;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* ---- tracker stepper ---- */

  /* #105's rail-and-dot reading (105-tracker.html), replacing #83's
     border-left-plus-pseudo-element dots with an explicit rail so each
     step's check icon has somewhere to sit — the class stays `.stepper`
     (theme.build.test.ts asserts a rule by that name) even though its
     internal shape has changed. */
  .stepper {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
  }

  .stepper li {
    display: flex;
    gap: var(--space-md);
  }

  .step-rail {
    flex: none;
    width: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .step-dot {
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    color: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step-dot svg {
    width: 12px;
    height: 12px;
  }

  .step-line {
    flex: 1;
    width: 2px;
    min-height: var(--space-lg);
    background: var(--color-border);
  }

  .stepper li:last-child .step-line {
    display: none;
  }

  .stepper li .step-label {
    padding: 1px 0 var(--space-lg);
    color: var(--color-text-muted);
  }

  .stepper li:last-child .step-label {
    padding-bottom: 0;
  }

  .stepper li.done .step-dot,
  .stepper li.current .step-dot {
    background: var(--color-accent-a);
    border-color: var(--color-accent-a);
  }

  .stepper li.current .step-dot {
    background: var(--color-accent-b);
    border-color: var(--color-accent-b);
  }

  .stepper li.done .step-line {
    background: var(--color-accent-a);
  }

  .stepper li.done .step-label,
  .stepper li.current .step-label {
    font-weight: 700;
    color: var(--color-text);
  }

  .tracker-countdown {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-weight: 700;
    margin: var(--space-md) 0 2px;
  }

  .tracker-countdown .vehicle-icon {
    width: 26px;
    height: 26px;
  }

  .tracker-countdown-big {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  /* ---- #169's celebratory Delivered hero and done rail (docs/design/
     162-*, "Delivered") — replaces the old plain "Delivered N min ago" line
     and, for this state only, the full per-step .stepper above. ---- */

  .tracker-delivered-hero {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin: var(--space-md) 0 var(--space-sm);
  }

  .tracker-delivered-stamp {
    flex: none;
    width: 76px;
    height: 76px;
    color: var(--color-accent-a);
    transform: rotate(-8deg);
  }

  /* An SVG child isn't constrained by its parent's box just because the
     parent has one — the checkmark rendered at its native ~440px viewBox
     size until this was added (docs/memory/engineer.md's img-attribute
     lesson applies to an inline svg the same way). */
  .tracker-delivered-stamp svg {
    width: 100%;
    height: 100%;
  }

  .tracker-delivered-headline {
    margin: 0;
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .tracker-delivered-early {
    margin: var(--space-xs) 0 0;
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .tracker-delivered-time {
    margin: 2px 0 0;
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .tracker-done-rail {
    margin: var(--space-md) 0 0;
  }

  .tracker-done-rail-track {
    display: flex;
    align-items: center;
  }

  .tracker-done-rail-dot {
    flex: none;
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--color-accent-a);
  }

  .tracker-done-rail-dot--last {
    width: 14px;
    height: 14px;
    background: var(--color-accent-b);
  }

  .tracker-done-rail-line {
    flex: 1;
    height: 2px;
    background: var(--color-accent-a);
  }

  .tracker-done-rail-labels {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-xs);
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .tracker-delivered-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .flavor-text {
    margin: var(--space-md) 0 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  [data-testid='tracker-empty'] {
    text-align: center;
    padding: var(--space-xl) 0;
  }

  /* ---- #148: multi-order Tracker — order stack, driver card, history
     (docs/design/147-tracker-multi-order-driver-history.md). Every class
     here is its own, prefixed `tracker-`, since tracker-dom.ts is a
     *-dom.ts module and BaseLayout's stylesheet has no scoping between
     modules (docs/memory/engineer.md). ---- */

  .tracker-cols {
    display: block;
  }

  .tracker-section-label {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin: 0 0 var(--space-sm);
    font-size: var(--font-size-muted);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .tracker-section-count {
    letter-spacing: 0;
  }

  .tracker-order-card {
    background: var(--color-surface);
    border-radius: 16px;
    padding: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .tracker-card-head {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
  }

  .tracker-thumb {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    object-fit: cover;
  }

  .tracker-thumb-placeholder {
    background: var(--color-border);
  }

  .tracker-card-name {
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .tracker-meta {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  /* ---- driver slot: same height whether a driver is assigned or not ---- */

  .tracker-driver {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    background: var(--color-tab-active-bg);
    border-radius: 12px;
    padding: 0 var(--space-sm) 0 var(--space-xs);
    min-height: 60px;
    margin-top: var(--space-lg);
  }

  .tracker-driver-avatar,
  .tracker-avatar-fallback {
    flex: none;
    width: 68px;
    height: 68px;
    margin-top: -20px;
    align-self: flex-end;
    border-radius: 999px;
  }

  .tracker-avatar-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-tab-active-bg);
    border: 2px solid var(--color-surface);
    color: var(--color-text-muted);
    font-weight: 700;
  }

  .tracker-driver-who {
    padding: var(--space-sm) 0;
    min-width: 0;
  }

  .tracker-driver-kicker {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .tracker-driver-name {
    font-weight: 800;
    font-size: 1rem;
    line-height: 1.2;
  }

  .tracker-rating {
    font-size: var(--font-size-muted);
    color: var(--color-text);
    font-weight: 700;
  }

  .tracker-rating-count {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .tracker-driver-vehicle {
    margin-left: auto;
    color: var(--color-text-muted);
    display: flex;
  }

  .tracker-driver-vehicle svg {
    width: 22px;
    height: 22px;
  }

  .tracker-driver-pending .tracker-driver-placeholder {
    flex: none;
    width: 48px;
    height: 48px;
    margin: 6px 10px 6px 6px;
    border-radius: 999px;
    border: 2px dashed var(--color-text-muted);
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tracker-driver-pending .tracker-driver-placeholder svg {
    width: 22px;
    height: 22px;
  }

  .tracker-driver-pending .tracker-driver-name {
    font-weight: 700;
    font-size: 0.9375rem;
  }

  /* ---- a collapsed live order: the switcher ---- */

  .tracker-order-row {
    width: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-align: left;
    font: inherit;
    color: inherit;
    background: var(--color-surface);
    border: none;
    border-radius: 14px;
    padding: var(--space-sm) var(--space-md) var(--space-sm) var(--space-sm);
    margin-bottom: var(--space-sm);
    min-height: 60px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .tracker-order-row:focus-visible {
    outline: 2px solid var(--color-accent-a);
    outline-offset: 2px;
  }

  .tracker-row-thumb {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    object-fit: cover;
  }

  .tracker-row-mid {
    flex: 1;
    min-width: 0;
    display: block;
  }

  .tracker-row-name {
    display: block;
    font-weight: 700;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tracker-row-status {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .tracker-row-status b {
    color: var(--color-text);
  }

  .tracker-row-driver-avatar,
  .tracker-row-status .tracker-avatar-fallback {
    width: 20px;
    height: 20px;
    border-radius: 999px;
    margin-top: 0;
  }

  .tracker-row-eta {
    flex: none;
    text-align: right;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .tracker-row-eta-unit {
    display: block;
    font-size: var(--font-size-muted);
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .tracker-row-chev {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--color-text-muted);
  }

  .tracker-row-chev svg {
    width: 100%;
    height: 100%;
  }

  /* ---- VIP card (#174, docs/design/162-*, "The VIP card: where and what")
     — sits between Live now and Past orders, always present once at least
     one order is stored. Same surface/radius/padding as .tracker-order-card
     just above, so it reads as one family of cards on the page. ---- */

  .vip-card {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    background: var(--color-surface);
    border-radius: 16px;
    padding: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .vip-stamp {
    flex: none;
    width: 40px;
    height: 40px;
    margin-top: 2px;
    border-radius: 999px;
  }

  .vip-stamp--none {
    border: 2px dashed var(--color-text-muted);
  }

  .vip-stamp--gold {
    background: var(--color-vip-gold);
  }

  .vip-stamp--platinum {
    background: var(--color-vip-platinum);
  }

  .vip-card-body {
    min-width: 0;
  }

  .vip-card-heading {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-weight: 800;
    margin: 0 0 var(--space-xs);
  }

  .vip-pill {
    display: inline-block;
    font-size: var(--font-size-muted);
    font-weight: 800;
    padding: 2px var(--space-sm);
    border-radius: 999px;
  }

  .vip-pill--gold {
    background: var(--color-vip-gold);
    color: var(--color-vip-gold-ink);
  }

  .vip-card-spend,
  .vip-card-progress,
  .vip-card-other-currency {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-xs);
  }

  .vip-card-footer {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    margin: var(--space-sm) 0 0;
  }

  .vip-meter {
    display: flex;
    gap: 4px;
    margin: var(--space-xs) 0;
  }

  .vip-meter-segment {
    width: 28px;
    height: 6px;
    border-radius: 3px;
    background: var(--color-border);
  }

  .vip-meter-segment.filled {
    background: var(--color-accent-a);
  }

  /* The checkout breakdown's inline "Gold"/"Platinum" tag next to "Delivery
     fee" (checkout-dom.ts), and the VIP line above the breakdown — same
     ink-on-fill pairing as .vip-pill above, quoted at 11.18/9.98 (gold) and
     11.30/11.04 (platinum) in contrast.test.ts. */
  .vip-tag {
    display: inline-block;
    font-size: var(--font-size-muted);
    font-weight: 800;
    padding: 1px var(--space-xs);
    border-radius: 999px;
    vertical-align: 1px;
  }

  .vip-tag--gold {
    background: var(--color-vip-gold);
    color: var(--color-vip-gold-ink);
  }

  .vip-tag--platinum {
    background: var(--color-vip-platinum);
    color: var(--color-vip-platinum-ink);
  }

  .vip-checkout-line {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    margin: var(--space-sm) 0 0;
  }

  .vip-checkout-line .vip-stamp {
    width: 20px;
    height: 20px;
    margin-top: 0;
  }

  .vip-checkout-line strong {
    color: var(--color-text);
  }

  /* ---- history ---- */

  .tracker-past {
    margin-top: var(--space-xl);
  }

  .tracker-history {
    list-style: none;
    margin: 0;
    padding: 0 var(--space-sm);
    background: var(--color-surface);
    border-radius: 16px;
  }

  .tracker-history-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding: var(--space-md) 0;
    border-top: 1px solid var(--color-border);
  }

  .tracker-history-row:first-child {
    border-top: none;
  }

  .tracker-history-thumb {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    object-fit: cover;
  }

  .tracker-history-mid {
    flex: 1;
    min-width: 0;
  }

  .tracker-history-name {
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tracker-history-meta {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .tracker-history-by {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  .tracker-history-driver-avatar,
  .tracker-history-by .tracker-avatar-fallback {
    width: 20px;
    height: 20px;
    border-radius: 999px;
    margin-top: 0;
  }

  .tracker-history-right {
    flex: none;
    text-align: right;
  }

  .tracker-history-total {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .tracker-history-sub {
    display: block;
    font-size: var(--font-size-muted);
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .tracker-history-state {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .tracker-history-state svg {
    width: 12px;
    height: 12px;
    color: var(--color-text-muted);
  }

  .tracker-device-note {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    margin: var(--space-sm) var(--space-xs) 0;
  }

  /* Rate/Order again action strip (#165, docs/design/162-*, "History rows":
     "indented to the text column") — a full-width row inside the flex-
     wrapped history item, aligned under the name/meta column past the
     thumb. */
  .tracker-history-actions {
    display: flex;
    align-items: center;
    flex: 1 0 calc(100% - 40px - var(--space-sm));
    gap: var(--space-sm);
    margin-left: calc(40px + var(--space-sm));
  }

  .tracker-action-button {
    flex: none;
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-muted);
    font-weight: 700;
    line-height: 1.15;
    /* A driver review of #173's history render found "Order again" wrapping
       to two lines at 375px — a flex item's default min-content width is its
       longest unbreakable word, not the whole phrase, so a tight row shrinks
       it to fit "Order"/"again" on separate lines instead of overflowing. */
    white-space: nowrap;
    border-radius: 999px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .tracker-action-button:focus-visible {
    outline: 2px solid var(--color-accent-a);
    outline-offset: 2px;
  }

  .tracker-action-primary {
    color: var(--color-bg);
    background: var(--color-accent-a);
    border: none;
  }

  .tracker-action-secondary {
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .tracker-history-rated-summary {
    margin: 0;
    font-size: var(--font-size-muted);
    font-weight: 700;
    color: var(--color-text-muted);
  }

  /* Collapses to nothing when the slot holds no control at all (docs/design/
     162-*, "History rows": "Nothing at all: wallet gate off"). */
  .tracker-history-tip-slot:empty {
    display: none;
  }

  .tracker-history-order-again {
    margin-left: auto;
  }

  /* ---- tip control (#171, docs/design/162-*, "Tips") ---- */

  .tracker-history-tipped {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: var(--font-size-muted);
    font-weight: 700;
  }

  .tracker-history-tipped svg {
    width: 14px;
    height: 14px;
    color: var(--color-accent-a);
  }

  .tracker-history-tip-note {
    flex: 1 0 100%;
    margin: var(--space-xs) 0 0 calc(40px + var(--space-sm));
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .tracker-tip-panel {
    flex: 1 0 100%;
    margin: var(--space-sm) 0 0 calc(40px + var(--space-sm));
    padding: var(--space-sm);
    background: var(--color-bg);
    border-radius: 12px;
  }

  .tracker-tip-panel-label {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-sm);
    margin-bottom: var(--space-xs);
    font-size: var(--font-size-muted);
    font-weight: 700;
  }

  .tracker-tip-panel-label span {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .tracker-tip-presets {
    display: flex;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .tracker-tip-preset {
    flex: 1;
    min-height: 44px;
    white-space: nowrap;
    padding: 0 var(--space-xs);
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .tracker-tip-preset.selected {
    border: 2px solid var(--color-accent-a);
  }

  .tracker-tip-preset--over {
    font-weight: 600;
    color: var(--color-text-muted);
    border-style: dashed;
  }

  .tracker-tip-short {
    padding: var(--space-xs) var(--space-sm);
    margin-bottom: var(--space-sm);
    font-size: var(--font-size-muted);
    border: 1px solid var(--color-text);
    border-radius: 10px;
  }

  .tracker-tip-short-lead {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .tracker-tip-panel-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .tracker-tip-panel-actions .tracker-action-primary {
    flex: 1;
    min-height: 48px;
  }

  .tracker-tip-cancel {
    color: var(--color-text);
    background: none;
    border: none;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tracker-tip-send[aria-disabled='true'] {
    opacity: 0.45;
  }

  .tracker-toast {
    position: fixed;
    left: var(--space-md);
    right: var(--space-md);
    bottom: calc(var(--space-md) + 64px);
    z-index: 40;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    font-size: var(--font-size-muted);
    color: var(--color-bg);
    background: var(--color-text);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.2);
  }

  .tracker-toast a {
    flex: none;
    font-weight: 800;
    color: inherit;
    text-decoration: underline;
  }

  @media (min-width: 481px) {
    /* The sitewide `main { max-width: 40rem }` (global.css) is sized for a
       single column. #147's wide layout is two columns — Live now capped at
       25rem, Past orders filling what's left — and needs a wider main or
       Past orders has almost no room: at 40rem, 25rem plus the 2.5rem gap
       leaves well under 25rem for two content columns of history rows'
       photo/name/date/driver/total, so a restaurant name wraps a few
       characters per line. 62rem matches 147-tracker-live-sf-light.html's
       own wide `main` rule. */
    main:has(#tracker-root) {
      max-width: 62rem;
    }

    .tracker-cols {
      display: grid;
      grid-template-columns: minmax(0, 25rem) minmax(0, 1fr);
      gap: var(--space-xxl);
      align-items: start;
    }

    .tracker-past {
      margin-top: 0;
    }
  }

  /* ---- rating sheet (#163, docs/design/162-rating-win-tips-rewards-vip.md,
     "The rating sheet and the win"): driver step, then restaurant step, then
     the win — bottom-anchored on the phone, a centred dialog at ≥481px, the
     one surface here with a shadow since it's the one thing that floats.
     Every colour pair below reuses an already-checked contrast row (the
     sheet's own background is --color-bg, exactly the "text on bg" /
     "muted on bg" pairing #162's contrast table already covers) — no new
     pair for contrast.test.ts. */

  .rating-sheet-overlay {
    position: fixed;
    inset: 0;
    z-index: 25;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .rating-sheet-scrim {
    position: fixed;
    inset: 0;
    background: rgba(36, 27, 51, 0.45);
    border: none;
    padding: 0;
  }

  .rating-sheet-panel {
    position: relative;
    width: 100%;
    max-width: 26rem;
    max-height: 92vh;
    overflow-y: auto;
    padding: var(--space-xl) var(--space-lg) var(--space-lg);
    background: var(--color-bg);
    border-radius: 16px 16px 0 0;
    box-shadow: 0 -8px 24px rgba(36, 27, 51, 0.18);
    animation: rating-sheet-in 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes rating-sheet-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rating-sheet-panel {
      animation: none;
    }
  }

  @media (min-width: 481px) {
    .rating-sheet-overlay {
      align-items: center;
    }

    .rating-sheet-panel {
      border-radius: 16px;
    }
  }

  .rating-sheet-close {
    position: absolute;
    /* A driver review of #176's win render found the focus ring clipped
       flush against the panel's own edge at `--space-sm` alone — the panel's
       `overflow-y: auto` (above) clips the x-axis too, so the ring needs
       clearance beyond its own `outline-offset`, not just the button's. */
    top: calc(var(--space-sm) + var(--space-xs));
    right: calc(var(--space-sm) + var(--space-xs));
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: var(--space-xs);
    color: var(--color-text-muted);
    background: none;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .rating-sheet-close svg {
    width: 20px;
    height: 20px;
  }

  .rating-sheet-close:focus-visible {
    outline: 2px solid var(--color-accent-a);
    outline-offset: 2px;
  }

  /* Pulled up above the sheet's own top edge (#147's head-out-of-frame idea,
     carried over) — the driver leans into the sheet. */
  .rating-sheet-avatar {
    display: block;
    width: 112px;
    height: 112px;
    margin: -68px auto var(--space-sm);
    border-radius: 999px;
    border: 4px solid var(--color-bg);
    background: var(--color-surface);
    object-fit: cover;
  }

  .rating-sheet-restaurant-photo {
    display: block;
    width: 72px;
    height: 72px;
    margin: 0 auto var(--space-sm);
    border-radius: 16px;
    object-fit: cover;
  }

  .rating-sheet-step-label {
    margin: 0 0 var(--space-xs);
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    text-align: center;
  }

  .rating-sheet-body h2 {
    text-align: center;
  }

  .rating-sheet-meta {
    margin: 0 0 var(--space-md);
    color: var(--color-text-muted);
    text-align: center;
  }

  .rating-sheet-body .star-picker,
  .rating-sheet-body .chip-group {
    justify-content: center;
  }

  .rating-sheet-star-word {
    margin: calc(-1 * var(--space-sm)) 0 var(--space-md);
    color: var(--color-text-muted);
    text-align: center;
  }

  .rating-sheet-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .rating-sheet-skip {
    flex: none;
    min-height: 44px;
    padding: 0 var(--space-sm);
    font-family: inherit;
    font-size: var(--font-size-body);
    font-weight: 700;
    color: var(--color-text-muted);
    background: none;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .rating-sheet-actions .place-order {
    flex: 1;
  }

  .rating-sheet-win {
    position: relative;
    text-align: center;
  }

  /* Behind the sheet's own content (docs/design/162-*, "Where the confetti
     draws") — a negative z-index paints below this stacking context's
     normal-flow siblings (the stamp, heading, summary), never above them. */
  .rating-sheet-confetti {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
  }

  .rating-sheet-stamp {
    width: 104px;
    height: 104px;
    margin: 0 auto var(--space-md);
    color: var(--color-accent-a);
    transform: rotate(-8deg);
  }

  .rating-sheet-win-summary {
    color: var(--color-text-muted);
  }

  /* #166's reward unlock mounts here. Collapsed only while empty
     (rating-sheet-dom.ts sets `aria-hidden` on this element itself, never on
     the ticket, so the attribute is a reliable "nothing rendered" flag) —
     without this qualifier the rule zeroed the slot's height even once the
     ticket was appended inside it, clipping the whole thing to nothing. */
  [data-testid='rating-sheet-reward-slot'][aria-hidden='true'] {
    height: 0;
  }

  /* #169's VIP nudge slot — same "collapse only via aria-hidden on the slot
     itself" rule as the reward slot just above, and the same reason: zeroing
     height unconditionally would clip the nudge once rendered inside it. */
  [data-testid='rating-sheet-vip-nudge-slot'][aria-hidden='true'] {
    height: 0;
  }

  .rating-sheet-vip-nudge {
    margin: 0 0 var(--space-md);
    text-align: left;
  }

  .rating-sheet-vip-nudge .vip-meter {
    justify-content: center;
  }

  .rating-sheet-vip-nudge-text {
    margin: 0;
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
    text-align: center;
  }

  /* The win's thanks-voucher ticket (#166, docs/design/162-*, "The thanks
     voucher"): a single tinted card, left-aligned against the sheet's
     otherwise centred copy. `--color-tab-active-bg` is exactly the mock's
     tint value in both themes, and `--color-text` on it is the "text on
     tint" pair #162's contrast table already checked (13.14 / 12.29) — no
     new pair beyond quoting that one for this component. */
  .rating-sheet-reward-ticket {
    margin: 0 0 var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-tab-active-bg);
    border-radius: 14px;
    color: var(--color-text);
    font-size: var(--font-size-muted);
    text-align: left;
  }

  /* ---- rating prompt (#80's tracker, Delivered state) ---- */

  [data-testid='rating-prompt'] {
    margin-top: var(--space-lg);
  }

  .star-picker {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: var(--space-sm) 0 var(--space-md);
  }

  .star {
    width: 44px;
    height: 44px;
    padding: var(--space-xs);
    color: var(--color-border);
    background: none;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .star svg {
    width: 100%;
    height: 100%;
  }

  .star.selected {
    color: var(--color-accent-a);
  }

  [data-testid='rating-tags'] {
    margin-bottom: var(--space-md);
  }

  /* ---- #105: restaurant menu composition, cart-card chevron, menu pill
     buttons — the last of this issue's own rules that don't already sit
     beside the shared component they extend above. Kept in its own section
     rather than interleaved with #107/#116's Checkout and Offers work
     above. ---- */

  .menu-hero {
    display: block;
    width: 100%;
    height: 160px;
    margin-bottom: var(--space-md);
    border-radius: 12px;
    object-fit: cover;
  }

  .restaurant-title {
    margin: var(--space-md) 0 2px;
  }

  /* Plain inline text, not flex (round 1 review, item 3) — flex's `gap`
     stacked with the literal " · " separators already in this line's text,
     reading as extra whitespace around the icon and after the ETA. The
     .vehicle-icon's own margin (see above) is the only source of the gap
     around it here too, same as every other site. */
  .restaurant-meta {
    margin: 0;
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  /* The menu's own Add/Sold-out control — a true pill, distinct from
     .add-button (theme.build.test.ts locks that one to border-radius:10px
     from #104's own fix, one step short of this mock's fully rounded
     999px). */
  .pill-btn {
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-md);
    border-radius: 999px;
    border: none;
    background: var(--color-accent-a);
    color: var(--color-bg);
    font-family: inherit;
    font-weight: 800;
    font-size: var(--font-size-muted);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .pill-btn.sold-out {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-weight: 700;
    cursor: default;
  }

  .cart-card-chevron {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .voucher-row-unlocking,
    .cart-row > .cart-line,
    .confirm-dialog {
      transition: none;
      animation: none;
    }
  }

  /* ---- wallet chip and sheet (docs/design/143-wallet.md; #146) ----
     Rendered at runtime by wallet-dom.ts into Header.astro's `.balance-slot`
     (empty and `display:none`-by-default at compile time, same as
     `.city-pill-slot`) and into `document.body` for the sheet overlay — both
     get no scoped `<style>` of their own, same unscoped-by-necessity pattern
     as the home feed above. */

  .wallet-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    min-height: 32px;
    padding: 0.25rem 0.75rem;
    font-family: inherit;
    font-size: var(--font-size-muted);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* A transparent 44px hit area rather than a bigger visible chip — the
     chip's own paint stays the mock's compact pill size (docs/design/
     143-wallet.md: "a 44px hit area from a transparent ::after extending
     6px vertically"). */
  .wallet-chip::after {
    content: '';
    position: absolute;
    inset: -6px -8px;
  }

  .wallet-chip--drip {
    border-color: var(--color-accent-a);
  }

  .wallet-chip-badge {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    line-height: 1;
    font-weight: 800;
    color: #fff;
    background: var(--color-accent-a);
    border: 2px solid var(--color-bg);
    border-radius: 999px;
  }

  .wallet-sheet-overlay {
    position: fixed;
    inset: 0;
    z-index: 25;
  }

  .wallet-sheet-overlay .scrim {
    position: fixed;
    inset: 0;
    background: rgba(36, 27, 51, 0.45);
    border: none;
    padding: 0;
  }

  .wallet-sheet-overlay .sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    max-width: 26rem;
    margin: 0 auto;
    max-height: 88vh;
    overflow-y: auto;
    padding: 0 var(--space-lg) var(--space-lg);
    background: var(--color-bg);
    border-radius: 12px 12px 0 0;
    box-shadow: 0 -8px 24px rgba(36, 27, 51, 0.18);
    animation: confirm-in 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wallet-sheet-overlay .drag-handle {
    display: flex;
    justify-content: center;
    padding: var(--space-sm) 0;
  }

  .wallet-sheet-overlay .drag-handle-bar {
    width: 40px;
    height: 5px;
    border-radius: 999px;
    background: var(--color-border);
  }

  .wallet-sheet-overlay .sheet-close {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: none;
    color: var(--color-text);
  }

  .wallet-sheet-overlay .sheet-close svg {
    width: 20px;
