---
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
  </head>
  <body>
    <Header currentPath={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <a href="/about/">What we log, and why</a>
    </footer>
  </body>
</html>

<script>
  import { initTracking } from '../lib/tracking-transport';

  initTracking();
</script>

<style is:global>
  /* Sitewide per docs/design/65-parody-flow.md's "Privacy note" section —
     same link text and destination as the checkout page's contextual one,
     so it reads as the same document found twice. Sits under the
     tab-bar-clearing padding main.astro already reserves at phone width. */
  .site-footer {
    max-width: 40rem;
    margin: 0 auto;
    padding: 0 var(--space-lg) var(--space-xl);
    text-align: center;
  }

  .site-footer a {
    color: var(--color-text-muted);
    font-size: var(--font-size-muted);
    letter-spacing: 0.05em;
  }

  /* main's own bottom padding (global.css) only clears the fixed tab bar for
     main's own content — the footer sits after it, so it needs the same
     clearance or the tab bar covers it at the bottom of the page. */
  @media (max-width: 480px) {
    .site-footer {
      padding-bottom: calc(56px + env(safe-area-inset-bottom) + var(--space-xl));
    }
  }

  /* Shared component styles for the Dontdropthatpromo parody
     (docs/design/65-parody-flow.md, docs/design/72-dontdropthatpromo-identity.md),
     used by more than one page's DOM module — lives here rather than
     duplicated per page, same reasoning as .reset-button in global.css. All
     tokens (spacing, color, type) are global.css's own, unchanged. */

  .drop-glyph {
    color: var(--color-accent-a);
  }

  .drop-glyph.dropped {
    color: var(--color-text-muted);
    opacity: 0.6;
    transform: rotate(-12deg);
    display: inline-block;
  }

  /* ---- landing: order-in-progress banner ---- */

  .order-banner {
    display: block;
    margin-bottom: var(--space-lg);
    padding: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-accent-a);
    color: var(--color-accent-a);
    font-weight: 700;
    text-decoration: none;
  }

  /* ---- home feed: location bar, search, promo banner, cuisine chips ----
     docs/design/80-two-city-brand-and-flow.md, screen 2 / 80-home-sf.html.
     Rendered by home-dom.ts into #home-root, which BaseLayout gives no
     scoped <style> of its own — these live here, unscoped, the same as
     every other DOM-module component below. */

  .location-bar {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: inherit;
    font-size: var(--font-size-muted);
    font-weight: 700;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: var(--space-xs) var(--space-md);
    min-height: 32px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .home-search {
    display: block;
    width: 100%;
    min-height: 44px;
    margin-top: var(--space-md);
    padding: 0 var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-body);
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .home-search::placeholder {
    color: var(--color-text-muted);
  }

  .promo-banner {
    margin-top: var(--space-md);
    padding: var(--space-md);
    display: flex;
    /* Column, not the row this started as (#82 review round 2, item 1): a
       row with a fixed-size image had no room left for the text at 375px
       and pushed it off the right edge, widening the whole page. Stacking
       keeps the image inside the box at any width and puts the heading
       directly beneath it, one of the two placements the mock allows. */
    flex-direction: column;
    gap: var(--space-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-accent-a);
    border-radius: 12px;
  }

  .promo-banner img {
    /* Scales to the box's own width instead of the SVG's intrinsic 343px,
       which is what overflowed a 375px viewport once the border/padding
       above were subtracted from it. Height follows from the img's own
       width/height attributes (343x96), so no separate aspect-ratio rule
       is needed here. */
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    object-fit: cover;
  }

  .promo-banner span {
    font-weight: 800;
    font-size: var(--font-size-body);
    color: var(--color-accent-a);
  }

  .cuisine-chips {
    margin-top: var(--space-md);
    display: flex;
    gap: var(--space-sm);
    overflow-x: auto;
    -webkit-mask-image: linear-gradient(to right, black 88%, transparent);
    mask-image: linear-gradient(to right, black 88%, transparent);
    padding-right: var(--space-lg);
  }

  .cuisine-chip {
    flex: none;
    min-height: 36px;
    display: flex;
    align-items: center;
    padding: 0 var(--space-md);
    font-family: inherit;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    font-size: var(--font-size-muted);
    font-weight: 700;
    color: var(--color-text-muted);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .cuisine-chip.selected {
    color: var(--color-accent-a);
    border-color: var(--color-accent-a);
  }

  /* ---- location picker (home screen 1) ---- */

  .location-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .location-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    padding: var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-body);
    color: var(--color-text);
    text-align: left;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .location-card img {
    border-radius: 8px;
    object-fit: cover;
  }

  .location-card-name {
    font-weight: 800;
  }

  .location-card-currency {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .location-blocked-notice {
    margin-top: var(--space-md);
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  /* ---- restaurant list ---- */

  .restaurant-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin: var(--space-md) 0 0;
    padding: 0;
  }

  .restaurant-card {
    position: relative;
    display: flex;
    gap: var(--space-md);
    padding: var(--space-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    color: var(--color-text);
    text-decoration: none;
    transition: transform 100ms ease-out;
    /* docs/design/46-phone-native.md, Touch feedback: no default browser
       tap-highlight, no text selection or iOS link-preview callout on a
       long press — every touch target on this site follows it, not only
       the ones #46 itself introduced. */
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
  }

  .restaurant-card:active {
    transform: scale(0.98);
  }

  .restaurant-card-photo {
    flex: none;
    width: 84px;
    height: 84px;
    border-radius: 10px;
    object-fit: cover;
  }

  .restaurant-card-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-width: 0;
  }

  .restaurant-card-name {
    font-weight: 800;
  }

  .restaurant-card-tag,
  .restaurant-card-meta {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .deal-badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    background: var(--color-accent-b);
    color: var(--color-badge-ink);
    font-size: 0.625rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 999px;
  }

  /* ---- menu / cart line items, shared shape ---- */

  .menu-list,
  .cart-list {
    list-style: none;
    margin: 0 0 var(--space-lg);
    padding: 0;
  }

  .menu-item-row,
  .cart-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .cart-line-name {
    flex: 1;
    min-width: 8rem;
  }

  .menu-item-photo {
    flex: none;
    border-radius: 8px;
    object-fit: cover;
  }

  /* The dish name, description and price sit in their own wrapping element
     (menu-dom.ts's textWrap) rather than being direct .menu-item-row
     children like .cart-line-name above — stacked here rather than left to
     fall onto one run-together line (driver review, #82 round 1, item 4). */
  .menu-item-text {
    flex: 1;
    min-width: 8rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .menu-item-name {
    font-weight: 700;
  }

  .menu-item-description {
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  .menu-item-price,
  .cart-line-total {
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .quantity-stepper {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .quantity-stepper button {
    min-width: 44px;
    min-height: 44px;
    font-family: inherit;
    font-size: var(--font-size-body);
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .quantity-count {
    min-width: 1.5rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .add-button,
  .remove-button {
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-body);
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    -webkit-tap-highlight-color: transparent;
  }

  .cart-summary {
    position: sticky;
    bottom: 0;
    display: block;
    padding: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-accent-a);
    font-weight: 700;
    text-decoration: none;
    text-align: center;
  }

  .cart-subtotal {
    font-weight: 700;
  }

  .cart-delivery-preview {
    color: var(--color-text-muted);
  }

  .cart-fee-note {
    margin-top: 0;
    font-size: var(--font-size-muted);
    color: var(--color-text-muted);
  }

  /* ---- checkout fields: preset choices only, nothing typed ---- */

  .checkout-field {
    margin-bottom: var(--space-sm);
  }

  .checkout-field h2 {
    margin-bottom: var(--space-sm);
  }

  .mini-field {
    margin-bottom: var(--space-md);
  }

  .mini-label {
    display: block;
    margin-bottom: var(--space-xs);
    font-size: var(--font-size-muted);
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .chip-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .chip {
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-body);
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .chip.selected {
    color: var(--color-accent-a);
    border-color: var(--color-accent-a);
    font-weight: 700;
  }

  .segmented {
    display: inline-flex;
    border: 1px solid var(--color-border);
  }

  .segmented button {
    min-height: 44px;
    min-width: 44px;
    padding: var(--space-sm) var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-body);
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: none;
    border-right: 1px solid var(--color-border);
    cursor: pointer;
  }

  .segmented button:last-child {
    border-right: none;
  }

  .segmented button.selected {
    color: var(--color-accent-a);
    background: var(--color-surface);
    font-weight: 700;
    box-shadow: inset 0 0 0 1px var(--color-accent-a);
  }

  .privacy-note {
    margin: 0 0 var(--space-lg);
  }

  .privacy-note a {
    color: var(--color-text-muted);
    font-size: var(--font-size-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* ---- checkout price breakdown (#80: Subtotal, Delivery fee, Service fee,
     Total — #89 adds Discount/"You saved" lines to this same block) ---- */

  .checkout-breakdown {
    margin: var(--space-md) 0;
    padding-top: var(--space-xs);
    border-top: 1px solid var(--color-border);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
    padding: var(--space-xs) 0;
  }

  .breakdown-row .muted {
    color: var(--color-text-muted);
  }

  .breakdown-row.total {
    font-weight: 800;
    font-size: var(--font-size-h2);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-xs);
    padding-top: var(--space-sm);
  }

  /* ---- demo disclosure (#80): sits directly above "Place order" and above
     the tracker's Delivered-state rating prompt ---- */

  .demo-disclosure {
    margin-bottom: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: var(--font-size-muted);
  }

  .demo-disclosure a {
    color: var(--color-accent-a);
    font-weight: 700;
  }

  .place-order {
    display: block;
    width: 100%;
    min-height: 44px;
    padding: var(--space-md);
    font-family: inherit;
    font-size: var(--font-size-body);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-align: center;
    text-decoration: none;
    color: var(--color-bg);
    background: var(--color-accent-a);
    border: none;
    cursor: pointer;
    transition: transform 100ms ease-out;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
  }

  .place-order:active {
    transform: scale(0.98);
  }

  .place-order:disabled {
    opacity: 0.6;
    cursor: default;
  }

  /* ---- order placed ---- */

  .order-placed-mark {
    color: var(--color-accent-a);
    margin: var(--space-lg) 0;
  }

  /* ---- tracker stepper ---- */

  .stepper {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    border-left: 2px solid var(--color-border);
  }

  .stepper li {
    position: relative;
    padding: 0 0 var(--space-lg) var(--space-lg);
  }

  .stepper li:last-child {
    padding-bottom: 0;
  }

  .stepper li::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 2px;
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
  }

  .stepper li.done::before {
    background: var(--color-accent-a);
    border-color: var(--color-accent-a);
  }

  .stepper li.current::before {
    background: var(--color-accent-b);
    border-color: var(--color-accent-b);
  }

  .stepper li.done .step-label,
  .stepper li.current .step-label {
    font-weight: 700;
    color: var(--color-text);
  }

  .stepper li .step-label {
    color: var(--color-text-muted);
  }

  .flavor-text {
    margin: var(--space-md) 0 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .given-up,
  [data-testid='tracker-empty'] {
    text-align: center;
    padding: var(--space-xl) 0;
  }

  .given-up .headline {
    font-size: 1.25rem;
    font-weight: 700;
    margin: var(--space-lg) 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .order-placed-mark,
    .drop-glyph {
      transition: none;
      animation: none;
    }
  }
</style>
