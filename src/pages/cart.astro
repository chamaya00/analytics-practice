---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Cart — Dontdropthatpromo">
  <!-- The page heading is cart-dom.ts's own: "Cart", "Your carts", or the
       restaurant's name, depending on which cart view the stored cart and
       ?restaurant= resolve to. -->
  <div id="cart-root" data-testid="cart-root"></div>
  <script>
    import { initCartPage } from '../lib/cart-dom';

    const root = document.getElementById('cart-root');
    if (root) initCartPage(root);
  </script>
</BaseLayout>
