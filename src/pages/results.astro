---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Results — analytics-practice">
  <h1>Dogfooding: how everyone voted</h1>
  <div id="dogfooding-root" data-testid="dogfooding-root"></div>
  <script>
    import { initResultsPage } from '../lib/poll-dom';

    const root = document.getElementById('dogfooding-root');
    if (root) initResultsPage(root);
  </script>
  <style is:global>
    /* The elements these rules target (.stat-total, .stat-list, .stat-row,
       the accent classes, .stat-prompt) are all created by
       src/lib/poll-dom.ts at runtime, not by this template, so Astro's
       scoped-style attribute never lands on them - this block has to be
       global or none of it would ever match in a browser. */

    /* Field Notebook: dashed rules instead of solid, and the per-variant
       list repositioned into a margin column via grid-row: 1 / -1, which
       spans however many rows column 1 ends up with (three normally, four
       with the empty-state prompt) without needing markup changes. */

    [data-testid="dogfooding-root"] {
      display: grid;
      grid-template-columns: 1fr minmax(6rem, auto);
      column-gap: var(--space-xl);
    }

    [data-testid="dogfooding-root"] > * {
      grid-column: 1;
    }

    [data-testid="votes-per-variant"] {
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: start;
      justify-self: end;
      margin-top: var(--space-xl);
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
    }

    .stat-total {
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
      margin: 0;
      padding: var(--space-lg) 0;
      border-bottom: 1px dashed var(--color-border);
    }

    .stat-total-number {
      font-size: var(--font-size-h1);
      font-weight: 400;
      line-height: 1.25;
      color: var(--color-text);
    }

    .stat-total-label {
      font-size: var(--font-size-muted);
      font-style: italic;
      color: var(--color-text-muted);
    }

    .stat-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .stat-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-md);
      margin: 0;
      padding: var(--space-lg) 0;
      border-bottom: 1px dashed var(--color-border);
    }

    .stat-row--meta {
      color: var(--color-text-muted);
      font-style: italic;
      font-size: var(--font-size-muted);
    }

    .stat-label {
      color: var(--color-text);
    }

    .stat-value {
      color: var(--color-text);
      font-weight: 400;
      font-size: 1.125rem;
    }

    .stat-value--muted {
      color: var(--color-text-muted);
      font-weight: 400;
      font-style: italic;
    }

    .stat-value.accent-a {
      color: var(--color-accent-a);
    }

    .stat-value.accent-b {
      color: var(--color-accent-b);
    }

    [data-testid="votes-per-variant"] .stat-row {
      flex-direction: column;
      align-items: flex-end;
      gap: 0;
      padding: 0;
      border-bottom: none;
    }

    [data-testid="votes-per-variant"] .stat-label {
      font-size: var(--font-size-muted);
      font-style: italic;
      color: var(--color-text-muted);
    }

    [data-testid="votes-per-variant"] .stat-value {
      font-size: var(--font-size-h2);
    }

    .stat-prompt {
      margin: 0 0 var(--space-lg);
      padding: 0;
      background: transparent;
      color: var(--color-text-muted);
      font-style: italic;
    }

    .stat-prompt a {
      color: var(--color-text-muted);
    }

    @media (max-width: 480px) {
      [data-testid="dogfooding-root"] {
        grid-template-columns: 1fr;
      }

      [data-testid="votes-per-variant"] {
        grid-column: 1;
        grid-row: auto;
        justify-self: stretch;
        align-items: flex-start;
        margin-top: 0;
        flex-direction: row;
        gap: var(--space-lg);
      }

      .stat-total,
      .stat-row {
        padding: var(--space-sm) 0;
      }
    }
  </style>
</BaseLayout>
