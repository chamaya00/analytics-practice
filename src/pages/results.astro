---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Results — analytics-practice">
  <h1>Dogfooding: how everyone voted</h1>
  <div id="dogfooding-root" data-testid="dogfooding-root"></div>
  <script>
    import { initResultsPage } from '../lib/poll-dom';

    const root = document.getElementById('dogfooding-root');
    if (root) initResultsPage(root);
  </script>
  <style is:global>
    /* The elements these rules target (.stat-total, .stat-list, .stat-row,
       the accent classes, .stat-prompt) are all created by
       src/lib/poll-dom.ts at runtime, not by this template, so Astro's
       scoped-style attribute never lands on them - this block has to be
       global or none of it would ever match in a browser. */

    .stat-total {
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
      margin: 0;
      padding: var(--space-md) 0;
      border-bottom: 1px solid var(--color-border);
    }

    .stat-total-number {
      font-size: var(--font-size-h2);
      font-weight: 600;
      line-height: 1.3;
      color: var(--color-text);
    }

    .stat-total-label {
      font-size: var(--font-size-muted);
      color: var(--color-text-muted);
    }

    .stat-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .stat-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-md);
      margin: 0;
      padding: var(--space-md) 0;
      border-bottom: 1px solid var(--color-border);
    }

    .stat-row--meta {
      color: var(--color-text-muted);
      font-size: var(--font-size-muted);
    }

    .stat-label {
      color: var(--color-text);
    }

    .stat-value {
      color: var(--color-text);
      font-weight: 600;
    }

    .stat-value--muted {
      color: var(--color-text-muted);
      font-weight: 400;
    }

    .stat-value.accent-a {
      color: #2b6cb0;
    }

    .stat-value.accent-b {
      color: #c05621;
    }

    .stat-prompt {
      margin: 0 0 var(--space-md);
      padding: var(--space-md);
      background: var(--color-surface);
      color: var(--color-text);
    }

    .stat-prompt a {
      color: var(--color-text);
    }

    @media (max-width: 480px) {
      .stat-total,
      .stat-row {
        padding: var(--space-sm) 0;
      }
    }
  </style>
</BaseLayout>
