---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Swipe poll — analytics-practice">
  <h1>Swipe poll</h1>
  <p>Tap (or swipe) an option to vote.</p>
  <div id="swipe-card-root" data-testid="swipe-card-root"></div>
  <script>
    import { initSwipePage } from '../lib/poll-dom';

    const root = document.getElementById('swipe-card-root');
    if (root) initSwipePage(root);
  </script>
  <style is:global>
    /* The elements these rules target (.swipe-card, .option-panel,
       .vote-confirmation, the accent classes, the end-state panel) are all
       created by src/lib/poll-dom.ts at runtime, not by this template, so
       Astro's scoped-style attribute never lands on them - this block has
       to be global or none of it would ever match in a browser. */

    /* Field Notebook: two "page" panels with a dashed rule between them
       standing in for a hand-kept divider. poll-dom.ts applies .voted
       synchronously with the confirmation text and the swipe-out class, so
       the spec's separate "casting" wash and "post-vote" rule collapse into
       one transition here, same as the Ledger preview's approach. */

    .swipe-card {
      display: flex;
      gap: 0;
      padding: var(--space-lg) var(--space-lg) 0;
      background: transparent;
    }

    .option-panel {
      flex: 1;
      min-width: 0;
      padding: var(--space-lg) var(--space-md);
      font-size: var(--font-size-body);
      font-family: inherit;
      font-style: italic;
      text-align: center;
      border: none;
      border-radius: var(--space-xs) var(--space-xs) 0 0;
      background: var(--color-surface);
      color: var(--color-text);
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(58, 46, 31, 0.15);
      transition: color 150ms ease-out;
    }

    .option-panel--left {
      border-right: 1px dashed var(--color-border);
    }

    .accent-a .option-panel:hover,
    .accent-a .option-panel:focus-visible,
    .accent-a .option-panel.voted {
      color: var(--color-accent-a);
    }

    .accent-b .option-panel:hover,
    .accent-b .option-panel:focus-visible,
    .accent-b .option-panel.voted {
      color: var(--color-accent-b);
    }

    .accent-a .option-panel.voted {
      border-bottom: 3px solid var(--color-accent-a);
    }

    .accent-b .option-panel.voted {
      border-bottom: 3px solid var(--color-accent-b);
    }

    .swipe-out-left,
    .swipe-out-right {
      transform: translateY(2rem) rotateX(-12deg);
      opacity: 0;
    }

    .vote-confirmation {
      margin: var(--space-sm) 0 0;
      padding: 0 var(--space-lg);
      background: transparent;
      color: var(--color-text-muted);
      font-style: italic;
      font-size: var(--font-size-muted);
      text-align: right;
    }

    [data-testid="swipe-card-end"] {
      padding: var(--space-lg);
      background: var(--color-surface);
      border-top: 3px double var(--color-border);
      box-shadow: 0 2px 6px rgba(58, 46, 31, 0.12);
    }

    [data-testid="swipe-card-end"] p {
      margin: 0 0 var(--space-md);
      color: var(--color-text);
    }

    [data-testid="swipe-card-end"] a {
      display: inline;
      padding: 0;
      border: none;
      color: var(--color-text);
      text-decoration: underline;
    }

    @media (max-width: 480px) {
      .swipe-card {
        padding: var(--space-md) var(--space-md) 0;
        gap: 0;
      }

      .option-panel {
        padding: var(--space-md) var(--space-sm);
      }
    }
  </style>
</BaseLayout>
