---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="dontdropthatpromo">
  <div id="home-root" data-testid="home-root"></div>
  <script>
    import { initHomePage } from '../lib/home-dom';

    const root = document.getElementById('home-root');
    const pillRoot = document.querySelector<HTMLElement>('[data-testid="city-pill-slot"]');
    if (root && pillRoot) initHomePage(root, pillRoot);
  </script>
</BaseLayout>
