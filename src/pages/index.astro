---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Swipe poll — analytics-practice">
  <h1>Swipe poll</h1>
  <p>Tap (or swipe) an option to vote.</p>
  <div id="swipe-card-root" data-testid="swipe-card-root"></div>
  <script>
    import { initSwipePage } from '../lib/poll-dom';

    const root = document.getElementById('swipe-card-root');
    if (root) initSwipePage(root);
  </script>
  <style is:global>
    /* The elements these rules target (.swipe-card, .pair-caption,
       .option-row, .option-panel, .vote-confirmation, the accent classes,
       the end-state panel) are all created by src/lib/poll-dom.ts at
       runtime, not by this template, so Astro's scoped-style attribute
       never lands on them - this block has to be global or none of it
       would ever match in a browser. */

    /* Console frame, one flung unit (revised by #47 - the card itself is
       now the drag surface, per docs/design/3-swipe-poll.md's rewritten
       Structure section). touch-action: pan-y (not none) leaves vertical
       scroll to the browser; a horizontal drag is claimed by poll-dom.ts's
       own pointer handlers, which reject a mostly-vertical motion via
       drag-gesture.ts before it ever becomes a vote - see the Constraints
       section of issue #47 for why touch-action: none is wrong here: a
       card spanning the viewport leaves nowhere else to start a scroll.

       Console frame: two sharp-cornered panels, Signal's structure, styled
       in Field Notebook's palette. poll-dom.ts applies .voted synchronously
       with the confirmation text and the swipe-out class, with no separate
       DOM hook for a distinct "casting" phase in between - the
       border-color transition below is what stands in for the spec's
       momentary console-cursor pulse.

       Adaptation: Signal's post-vote treatment is a low-opacity accent
       box-shadow ("status-light glow"), built to read against its own
       near-black surface. Against this hybrid's light cream surface
       (#fffaf0) a glow of that kind barely shows. Replaced with a
       border-weight change instead - the voted panel's border goes from
       1px to 3px in the accent color - which reads as "lit up" without
       relying on a shadow a light surface can't show off. */

    .swipe-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-lg);
      padding: var(--space-xl) var(--space-lg) var(--space-lg);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0;
      touch-action: pan-y;
      transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1), opacity 320ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .swipe-card--dragging {
      transition: none;
    }

    .pair-caption {
      margin: 0;
      font-size: 1.5rem;
      font-weight: 700;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }

    .option-row {
      display: flex;
      gap: var(--space-md);
      width: 100%;
    }

    .option-panel {
      flex: 1;
      min-width: 0;
      min-height: 44px;
      padding: var(--space-sm) var(--space-md);
      font-size: var(--font-size-muted);
      font-family: inherit;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      border: 1px solid var(--color-border);
      border-radius: 0;
      background: var(--color-surface);
      color: var(--color-text);
      cursor: pointer;
      transition: border-color 150ms ease-out, border-width 150ms ease-out, color 150ms ease-out;
    }

    .accent-a .option-panel:hover,
    .accent-a .option-panel:focus-visible,
    .accent-a .option-panel.voted {
      border-color: var(--color-accent-a);
      color: var(--color-accent-a);
    }

    .accent-a .option-panel.voted {
      border-width: 3px;
    }

    .accent-b .option-panel:hover,
    .accent-b .option-panel:focus-visible,
    .accent-b .option-panel.voted {
      border-color: var(--color-accent-b);
      color: var(--color-accent-b);
    }

    .accent-b .option-panel.voted {
      border-width: 3px;
    }

    .swipe-out-left,
    .swipe-out-right {
      transform: translateY(120%);
      opacity: 0;
    }

    .vote-confirmation {
      margin: var(--space-sm) 0 0;
      padding: 0;
      background: transparent;
      color: var(--color-text-muted);
      font-size: var(--font-size-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      text-align: center;
    }

    .accent-a .vote-confirmation {
      color: var(--color-accent-a);
    }

    .accent-b .vote-confirmation {
      color: var(--color-accent-b);
    }

    [data-testid="swipe-card-end"] {
      padding: var(--space-lg);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      text-align: center;
    }

    [data-testid="swipe-card-end"] p {
      margin: 0 0 var(--space-md);
      color: var(--color-text);
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    [data-testid="swipe-card-end"] a {
      display: inline-block;
      padding: var(--space-sm) var(--space-md);
      border: 1px solid var(--color-border);
      border-radius: 0;
      color: var(--color-text);
      text-transform: uppercase;
      letter-spacing: 0.03em;
      text-decoration: none;
    }

    @media (max-width: 480px) {
      .swipe-card {
        padding: var(--space-md);
        gap: var(--space-sm);
      }

      .option-panel {
        padding: var(--space-md) var(--space-sm);
      }
    }

    /* docs/design/46-phone-native.md, Card motion: reduced motion removes
       the transform animation entirely rather than shortening it - the
       voted card disappears and the next pair appears as a plain state
       change, with no translate, no rotate, and no opacity fade standing
       in for either. */
    @media (prefers-reduced-motion: reduce) {
      .swipe-card {
        transition: none;
      }

      .swipe-out-left,
      .swipe-out-right {
        transform: none;
        opacity: 1;
      }
    }
  </style>
</BaseLayout>
