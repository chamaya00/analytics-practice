---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Swipe poll — analytics-practice">
  <h1>Swipe poll</h1>
  <p>Tap (or swipe) an option to vote.</p>
  <div id="swipe-card-root" data-testid="swipe-card-root"></div>
  <script>
    import { initSwipePage } from '../lib/poll-dom';

    const root = document.getElementById('swipe-card-root');
    if (root) initSwipePage(root);
  </script>
  <style is:global>
    /* The elements these rules target (.swipe-card, .option-panel,
       .vote-confirmation, the accent classes, the end-state panel) are all
       created by src/lib/poll-dom.ts at runtime, not by this template, so
       Astro's scoped-style attribute never lands on them - this block has
       to be global or none of it would ever match in a browser. */

    /* Console frame: two sharp-cornered panels lit against a dark surface.
       poll-dom.ts applies .voted synchronously with the confirmation text
       and the swipe-out class, with no separate DOM hook for a distinct
       "casting" phase in between - the border-color transition below is
       what stands in for the spec's momentary console-cursor pulse. */

    .swipe-card {
      display: flex;
      gap: var(--space-md);
      padding: var(--space-md);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0;
      transition: transform 400ms ease-in, opacity 400ms ease-in;
    }

    .option-panel {
      flex: 1;
      min-width: 0;
      padding: var(--space-lg) var(--space-md);
      font-size: var(--font-size-body);
      font-family: inherit;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      border: 1px solid var(--color-border);
      border-radius: 0;
      background: var(--color-surface);
      color: var(--color-text);
      cursor: pointer;
      transition: border-color 150ms ease-out, color 150ms ease-out, box-shadow 150ms ease-out;
    }

    .accent-a .option-panel:hover,
    .accent-a .option-panel:focus-visible,
    .accent-a .option-panel.voted {
      border-color: var(--color-accent-a);
      color: var(--color-accent-a);
    }

    .accent-a .option-panel.voted {
      box-shadow: 0 0 0.75rem 0 var(--color-accent-a);
    }

    .accent-b .option-panel:hover,
    .accent-b .option-panel:focus-visible,
    .accent-b .option-panel.voted {
      border-color: var(--color-accent-b);
      color: var(--color-accent-b);
    }

    .accent-b .option-panel.voted {
      box-shadow: 0 0 0.75rem 0 var(--color-accent-b);
    }

    .swipe-out-left,
    .swipe-out-right {
      transform: translateY(120%);
      opacity: 0;
    }

    .vote-confirmation {
      margin: var(--space-sm) 0 0;
      padding: 0;
      background: transparent;
      color: var(--color-text-muted);
      font-size: var(--font-size-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      text-align: center;
    }

    .accent-a .vote-confirmation {
      color: var(--color-accent-a);
    }

    .accent-b .vote-confirmation {
      color: var(--color-accent-b);
    }

    [data-testid="swipe-card-end"] {
      padding: var(--space-lg);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      text-align: center;
    }

    [data-testid="swipe-card-end"] p {
      margin: 0 0 var(--space-md);
      color: var(--color-text);
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    [data-testid="swipe-card-end"] a {
      display: inline-block;
      padding: var(--space-sm) var(--space-md);
      border: 1px solid var(--color-border);
      border-radius: 0;
      color: var(--color-text);
      text-transform: uppercase;
      letter-spacing: 0.03em;
      text-decoration: none;
    }

    @media (max-width: 480px) {
      .swipe-card {
        padding: var(--space-md);
        gap: var(--space-sm);
      }

      .option-panel {
        padding: var(--space-md) var(--space-sm);
      }
    }
  </style>
</BaseLayout>
