---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Checkout — Dontdropthatpromo">
  <h1>Checkout</h1>
  <div id="checkout-root" data-testid="checkout-root"></div>
  <script>
    import { initCheckoutPage } from '../lib/checkout-dom';

    const root = document.getElementById('checkout-root');
    if (root) initCheckoutPage(root);
  </script>
</BaseLayout>
