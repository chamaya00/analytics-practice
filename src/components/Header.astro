---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isHome = currentPath === '/';

const links = [
  { href: '/', label: 'Home' },
  { href: '/cart/', label: 'Cart' },
  { href: '/tracker/', label: 'Tracker' },
];

// Tab bar icons only — docs/design/80-two-city-brand-and-flow.md's mocks
// (80-home-sf.html) show an icon above each phone tab bar label; the
// desktop nav (.site-nav) stays text-only, unchanged. Markup copied from
// that mock so the shapes match exactly.
const TAB_ICON_PATHS: Record<string, string> = {
  Home: '<path d="M4 11 12 4 20 11" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 10v9h12v-9" stroke-linecap="round" stroke-linejoin="round"/>',
  Cart: '<path d="M6 8h12l-1 12H7L6 8Z" stroke-linejoin="round"/><path d="M9 8V6a3 3 0 0 1 6 0v2" stroke-linecap="round"/>',
  Tracker: '<circle cx="12" cy="10" r="3.5"/><path d="M12 21c4-4.5 7-8 7-11a7 7 0 0 0-14 0c0 3 3 6.5 7 11Z"/>',
};
---

<header class="site-header">
  <div class="brand-group" class:list={{ 'brand-group--home': isHome }}>
    <p class="site-name">
      <span class="wordmark"
        ><span class="wordmark-strong">dont</span><wbr /><span class="wordmark-light">drop</span><wbr /><span
          class="wordmark-light">that</span
        ><wbr /><span class="wordmark-light">prom<span class="wordmark-tail">o</span></span></span
      >
    </p>
    {
      isHome && (
        <>
          <div class="city-pill-slot" data-testid="city-pill-slot" />
          <div class="balance-slot" data-testid="balance-slot" aria-hidden="true" />
        </>
      )
    }
  </div>
  <nav aria-label="Primary" class="site-nav">
    {
      links.map((link) => {
        const isCurrent = currentPath === link.href;
        return (
          <a href={link.href} aria-current={isCurrent ? 'page' : undefined} class:list={{ current: isCurrent }}>
            {link.label}
            {link.label === 'Cart' && <span class="cart-badge" data-testid="cart-badge" hidden></span>}
          </a>
        );
      })
    }
  </nav>
  {
    isHome && (
      <p class="home-intro" data-testid="home-intro">
        <strong>A parody delivery app for practicing product analytics.</strong> Every tap fires a real,
        anonymous event — nothing's charged, no food arrives. Pick a city and place a fake order.
      </p>
    )
  }
</header>

<nav aria-label="Primary" class="tab-bar">
  {
    links.map((link) => {
      const isCurrent = currentPath === link.href;
      return (
        <a href={link.href} aria-current={isCurrent ? 'page' : undefined} class:list={{ current: isCurrent }}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={TAB_ICON_PATHS[link.label]} />
          {isCurrent ? <span class="pill tab-label">{link.label}</span> : <span class="tab-label">{link.label}</span>}
          {link.label === 'Cart' && <span class="cart-badge" data-testid="cart-badge-phone" hidden></span>}
        </a>
      );
    })
  }
</nav>

<script>
  import { initCartBadge } from '../lib/header-dom';

  initCartBadge(document);
</script>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    min-height: var(--space-xxl);
    padding: var(--space-sm) var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex: none;
  }

  /* Home-only city pill and wallet-balance placeholder (docs/design/
     137-carousel-header-tiles.md, "Header row"): reserved but not shown
     outside the phone-width composition the mocks and arithmetic below
     were built for — desktop keeps today's wordmark-and-nav row unchanged. */
  .city-pill-slot,
  .balance-slot {
    display: none;
  }

  .site-name {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--font-size-nav-title);
    line-height: 1.2;
    letter-spacing: normal;
    /* Grid/flex items default to min-width: auto (their content's min-content
       size), which ignores the 1fr track above and overflows into the pill's
       column instead of wrapping at the wordmark's own <wbr> points — the
       same fix docs/design's .voucher-main/.confirm-button already use for
       exactly this. */
    min-width: 0;
  }

  /* docs/design/80-two-city-brand-and-flow.md: lowercase, weight-split,
     one word — no display:flex on this element itself, because flex's
     `gap` also applies between the anonymous boxes it creates for the
     bare <wbr> elements, visibly splitting the word into chunks (found
     rendering the mock, round 4). */
  .wordmark {
    flex: none;
    font-weight: 500;
  }

  .wordmark-strong {
    font-weight: 800;
  }

  /* docs/design/80-two-city-brand-and-flow.md: "The final "o" carries a
     small tail curling off its bottom-right, the one mark this direction
     adds, standing in for a logomark" - drawn as in 80-home-sf.html, and
     replacing the parody's separate drop glyph. */
  .wordmark-tail {
    position: relative;
  }

  .wordmark-tail::after {
    content: '';
    position: absolute;
    right: -3px;
    bottom: -2px;
    width: 6px;
    height: 6px;
    border-bottom: 2px solid var(--color-accent-a);
    border-right: 2px solid var(--color-accent-a);
    border-radius: 0 0 6px 0;
  }

  .site-nav {
    display: flex;
    gap: var(--space-md);
  }

  /* docs/design/235-first-screen-intro.md: home only, on its own line under
     the wordmark row. The first sentence is full-contrast, the rest muted. */
  .home-intro {
    flex: 0 0 100%;
    max-width: 30rem;
    margin: 2px 0 0;
    font-size: var(--font-size-muted);
    line-height: 1.25;
    color: var(--color-text-muted);
  }

  .home-intro strong {
    color: var(--color-text);
    font-weight: 700;
  }

  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--font-size-body);
    text-decoration: none;
  }

  .site-nav a.current {
    text-decoration: underline;
    pointer-events: none;
  }

  /* Bottom tab bar: phone only (see .tab-bar display: flex below). Hidden
     on desktop/tablet so nav is never shown in two places at once. */
  .tab-bar {
    display: none;
  }

  /* The small filled count circle on the Cart destination — docs/design/65-parody-flow.md,
     Nav: "only rendered when the count is greater than zero", toggled by
     header-dom.ts rather than shown/hidden here. */
  .cart-badge {
    min-width: 16px;
    height: 16px;
    padding: 0 3px;
    margin-left: var(--space-xs);
    border-radius: 999px;
    background: var(--color-accent-a);
    color: var(--color-bg);
    font-size: 0.625rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* [hidden] is a browser default of display:none, but the flex rule above
     has higher specificity and overrides it — without this, an empty cart
     shows as a blank filled dot on the Cart tab (driver review, #67). */
  .cart-badge[hidden] {
    display: none;
  }

  @media (max-width: 480px) {
    .site-header {
      justify-content: flex-start;
      border-bottom: none;
      padding-top: max(var(--space-sm), env(safe-area-inset-top));
      padding-left: max(var(--space-lg), env(safe-area-inset-left));
      padding-right: max(var(--space-lg), env(safe-area-inset-right));
    }

    /* Phone header carries branding only; nav moves to the tab bar below
       so "am I here" is never shown in two places at once. */
    .site-header .site-nav {
      display: none;
    }

    /* Home only (docs/design/137-carousel-header-tiles.md, "Header row"):
       a three-column grid, not a two-item flex row, so the pill sits on the
       row's true centre line regardless of how the wordmark's or the
       balance placeholder's own widths compare — the two equal 1fr side
       columns are what buy that, not the wordmark and placeholder
       happening to match widths. */
    .brand-group--home {
      flex: 1;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      column-gap: var(--space-sm);
    }

    /* .wordmark's own `flex: none` (above) is right everywhere else — it
       only exists to stop `.wordmark` itself becoming a flex container
       (which would split the bare <wbr> elements' anonymous boxes apart).
       In the three-column row it also has to be allowed to shrink and wrap
       at those <wbr> points instead of overflowing column 1 — the first
       composition that actually puts the wordmark under width pressure
       (docs/design/137-carousel-header-tiles.md's own "Header row"). */
    .brand-group--home .wordmark {
      flex: 1 1 auto;
      min-width: 0;
    }

    .brand-group--home .city-pill-slot,
    .brand-group--home .balance-slot {
      display: flex;
      align-items: center;
      min-height: 32px;
    }

    .brand-group--home .city-pill-slot {
      justify-content: center;
    }

    /* Invisible on the live page — a dashed border is this repository's mock
       convention for "reference only, not this issue's to build", but
       shipped as-is it reads as an unexplained outline to a real visitor
       (driver review, PR #150 round 1, item 6). The slot, its size and the
       reserved grid column stay; #136 fills it with the real balance. */
    .brand-group--home .balance-slot {
      justify-self: end;
      padding: 0 var(--space-sm);
      min-width: 44px;
    }

    .tab-bar {
      display: flex;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      /* Fixed at the viewport bottom with page content (e.g. .restaurant-card,
         BaseLayout.astro) painted after it in the DOM, so without an explicit
         stack this bar loses to ordinary content while scrolling. Above page
         content, below the flash overlay's 20 and the confirm dialog's 30
         (both BaseLayout.astro) so those still cover it unchanged (#118). */
      z-index: 10;
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
      padding-bottom: max(var(--space-sm), env(safe-area-inset-bottom));
      padding-left: max(var(--space-lg), env(safe-area-inset-left));
      padding-right: max(var(--space-lg), env(safe-area-inset-right));
    }

    .tab-bar a {
      position: relative;
      flex: 1;
      min-height: 44px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      color: var(--color-text-muted);
      text-decoration: none;
      font-size: var(--font-size-muted);
      padding: var(--space-xs) var(--space-sm);
      transition: transform 100ms ease-out;
      -webkit-tap-highlight-color: transparent;
      -webkit-touch-callout: none;
      -webkit-user-select: none;
      -moz-user-select: none;
      user-select: none;
    }

    .tab-bar a svg {
      width: 20px;
      height: 20px;
    }

    .tab-bar a:active {
      transform: scale(0.97);
    }

    /* Current tab is shown by a filled pill, not an underline (a tab bar
       label isn't read as an underlined link the way header text is). */
    .tab-bar a.current {
      color: var(--color-text);
      font-weight: 700;
      pointer-events: none;
    }

    .tab-bar a.current .pill {
      display: inline-block;
      padding: var(--space-xs) var(--space-md);
      background: var(--color-tab-active-bg);
      border-radius: 999px;
    }

    .tab-bar .cart-badge {
      position: absolute;
      top: 2px;
      right: calc(50% - 26px);
      margin-left: 0;
    }
  }
</style>
