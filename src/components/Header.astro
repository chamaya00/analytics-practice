---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: '/', label: 'Swipe poll' },
  { href: '/results/', label: 'Results' },
];
---

<header class="site-header">
  <p class="site-name">Analytics practice</p>
  <nav aria-label="Primary" class="site-nav">
    {
      links.map((link) => {
        const isCurrent = currentPath === link.href;
        return (
          <a href={link.href} aria-current={isCurrent ? 'page' : undefined} class:list={{ current: isCurrent }}>
            {link.label}
          </a>
        );
      })
    }
  </nav>
</header>

<nav aria-label="Primary" class="tab-bar">
  {
    links.map((link) => {
      const isCurrent = currentPath === link.href;
      return (
        <a href={link.href} aria-current={isCurrent ? 'page' : undefined} class:list={{ current: isCurrent }}>
          {isCurrent ? <span class="pill">{link.label}</span> : link.label}
        </a>
      );
    })
  }
</nav>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    min-height: var(--space-xxl);
    padding: var(--space-sm) var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .site-name {
    margin: 0;
    font-size: var(--font-size-nav-title);
    font-weight: 800;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .site-nav {
    display: flex;
    gap: var(--space-md);
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--font-size-body);
    text-decoration: none;
  }

  .site-nav a.current {
    text-decoration: underline;
    pointer-events: none;
  }

  /* Bottom tab bar: phone only (see .tab-bar display: flex below). Hidden
     on desktop/tablet so nav is never shown in two places at once. */
  .tab-bar {
    display: none;
  }

  @media (max-width: 480px) {
    .site-header {
      justify-content: flex-start;
      border-bottom: none;
      padding-top: max(var(--space-sm), env(safe-area-inset-top));
      padding-left: max(var(--space-lg), env(safe-area-inset-left));
      padding-right: max(var(--space-lg), env(safe-area-inset-right));
    }

    /* Phone header carries branding only; nav moves to the tab bar below
       so "am I here" is never shown in two places at once. */
    .site-header .site-nav {
      display: none;
    }

    .tab-bar {
      display: flex;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
      padding-bottom: max(var(--space-sm), env(safe-area-inset-bottom));
      padding-left: max(var(--space-lg), env(safe-area-inset-left));
      padding-right: max(var(--space-lg), env(safe-area-inset-right));
    }

    .tab-bar a {
      flex: 1;
      min-height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-text-muted);
      text-decoration: none;
      font-size: var(--font-size-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: var(--space-sm);
    }

    /* Current tab is shown by a filled pill, not an underline (a tab bar
       label isn't read as an underlined link the way header text is). */
    .tab-bar a.current {
      color: var(--color-text);
      font-weight: 700;
      pointer-events: none;
    }

    .tab-bar a.current .pill {
      display: inline-block;
      padding: var(--space-xs) var(--space-md);
      background: var(--color-tab-active-bg);
      border-radius: 999px;
    }
  }
</style>
